{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arcturus",
  "scopeName": "source.storyarc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#uuid"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#kinds"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#services"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#markers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.storyarc",
          "match": "//.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "Declaration heads that introduce a named entity.",
          "match": "^\\s*(kind|room|thing)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "entity.name.type.storyarc"
            }
          }
        },
        {
          "match": "^\\s*(block)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "entity.name.function.storyarc"
            }
          }
        },
        {
          "comment": "A topic on a person, or a shared subject at file level: topic/subject <id> \"label\" ...",
          "match": "^\\s*(topic|subject)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "entity.name.function.storyarc"
            }
          }
        },
        {
          "match": "^\\s*(global|constant|flag|counter)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "variable.other.storyarc"
            }
          }
        },
        {
          "comment": "Growing and replacing verbs (docs/01 chapter 12): enhance verb adds grammar, redefine verb replaces the family whole.",
          "match": "^\\s*(enhance|redefine)\\s+(verb)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "keyword.declaration.storyarc"
            }
          }
        },
        {
          "comment": "The when-language guard (docs/01 chapter 22): a declaration group that exists only when the game speaks that language.",
          "match": "^\\s*(when)\\s+(language)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "keyword.declaration.storyarc"
            }
          }
        },
        {
          "comment": "A bare action declaration (docs/01 chapter 12): an action with no verb attached, reachable from code but not the keyboard.",
          "match": "^\\s*(action)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "entity.name.function.storyarc"
            }
          }
        },
        {
          "match": "^\\s*(game|verb|grains|ranks|ambience)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            }
          }
        },
        {
          "comment": "Language-layer declarations: words the parser reads (docs/01 chapters 14 and 21).",
          "match": "^\\s*(direction|particle|pronoun|chain|noise|fold|all|language|catalog)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            }
          }
        },
        {
          "comment": "player.words / player.desc: augmenting the seeded player (docs/01 5a).",
          "match": "^\\s*(player)(\\.)([a-z_][a-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.language.storyarc"
            },
            "3": {
              "name": "support.type.property.storyarc"
            }
          }
        },
        {
          "comment": "A German gender line: a bare der/die/das in an object body (docs/01 chapter 21).",
          "match": "^\\s*(der|die|das)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.other.gender.storyarc"
            }
          }
        },
        {
          "comment": "The three summon forms: summon.feature (bundled), summon name.granule (searched), summon \"path\" (a file, highlighted as a string).",
          "match": "^\\s*(summon)(?:(\\.[A-Za-z][A-Za-z0-9_]*)|\\s+([A-Za-z][A-Za-z0-9_]*\\.granule))?",
          "captures": {
            "1": {
              "name": "keyword.control.import.storyarc"
            },
            "2": {
              "name": "storage.modifier.storyarc"
            },
            "3": {
              "name": "storage.modifier.storyarc"
            }
          }
        },
        {
          "comment": "catalog/matrix <name>: the declaration head and its name.",
          "match": "^\\s*(catalog|matrix|ranks)\\s+([A-Za-z][A-Za-z0-9_]*)?",
          "captures": {
            "1": {
              "name": "keyword.declaration.storyarc"
            },
            "2": {
              "name": "entity.name.type.storyarc"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.storyarc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.storyarc",
          "match": "\\\\([\"\\\\$n])"
        },
        {
          "name": "meta.interpolation.storyarc",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.storyarc"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.storyarc"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#services"
            },
            {
              "include": "#calls"
            },
            {
              "include": "#operators"
            },
            {
              "comment": "The leading article or copula of an interpolation, with an optional case tag.",
              "match": "\\b(the|The|a|an|A|An|is|Is)(?::[a-z]+)?\\b",
              "name": "keyword.other.article.storyarc"
            },
            {
              "match": "\\b([A-Za-z][A-Za-z0-9_]*)\\b",
              "name": "variable.other.interpolated.storyarc"
            }
          ]
        }
      ]
    },
    "uuid": {
      "name": "constant.other.uuid.storyarc",
      "match": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b"
    },
    "numbers": {
      "name": "constant.numeric.storyarc",
      "match": "\\b-?[0-9]+\\b"
    },
    "constants": {
      "name": "constant.language.storyarc",
      "match": "\\b(true|false|nothing)\\b"
    },
    "builtins": {
      "name": "variable.language.storyarc",
      "match": "\\b(self|player|here|noun|second|turns|score|max_score|way|grain|refused|ambience_rate|action|verb_trigger|meta_turn)\\b"
    },
    "kinds": {
      "patterns": [
        {
          "comment": "Standard Cosmos kinds, highlighted only in kind position (after `of`).",
          "match": "\\b(of)\\s+(thing|room|container|supporter|door|character)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.word.storyarc"
            },
            "2": {
              "name": "support.class.kind.storyarc"
            }
          }
        },
        {
          "comment": "The backstage scope room: `in scope` places an object always in scope (docs/01 chapter 3).",
          "match": "\\b(in|to)\\s+(scope)\\b",
          "captures": {
            "1": {
              "name": "keyword.operator.word.storyarc"
            },
            "2": {
              "name": "support.class.kind.storyarc"
            }
          }
        }
      ]
    },
    "attributes": {
      "comment": "Standard Cosmos boolean attributes (docs/01 chapter 3).",
      "name": "support.type.attribute.storyarc",
      "match": "\\b(fixed|scenery|hidden|concealed|wearable|worn|lit|edible|named|switchable|binary|active|glow|openable|open|lockable|locked|visited|clear|seen|moved|animate|an|feminine|neutral|pluribus|beyond|scored|component|shiftable|restless)\\b"
    },
    "properties": {
      "comment": "Standard Cosmos value properties and the topic modifiers.",
      "patterns": [
        {
          "name": "support.type.property.storyarc",
          "match": "\\b(name|desc|intro|appearance|words|capacity|spans|unseal_with|article|indefinite|tag|plural|arc_image)\\b"
        },
        {
          "comment": "Topic, ambience, and rank header modifiers (docs/01 chapters 19, 17, and 22).",
          "name": "keyword.other.modifier.storyarc",
          "match": "\\b(once|hidden|idle|about|order|at|percent|points|turns|meta|timers)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.storyarc",
          "match": "\\b(if|else|while|for|each|switch|case|when|return|stop|continue|finish|death|alter|do|on|after|every|append|insert|clear|load|swapping|capacity|checked|vary|sequence|mutate|loop)\\b"
        },
        {
          "name": "keyword.other.statement.storyarc",
          "match": "\\b(let|change|now|move|add|remove|say|show|zcolor|par|to|from|start)\\b"
        },
        {
          "comment": "The award statement: score enters the game only through it (docs/01 6a).",
          "match": "\\b(award)\\s+([0-9]+)(?:\\s+(for)\\s+([A-Za-z][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.other.statement.storyarc"
            },
            "2": {
              "name": "constant.numeric.storyarc"
            },
            "3": {
              "name": "keyword.operator.word.storyarc"
            },
            "4": {
              "name": "entity.name.tag.pool.storyarc"
            }
          }
        },
        {
          "comment": "Dot-modifier chains, three scopes (Stefan's policy, 2026-07-04): the KEYWORD (say, zcolor, par), the MODIFIER chain (.par, .yellow, .font - one scope, dots included), and the trailing VALUE (the colour word of a zcolor line). say.yellow.par, par.say, zcolor.font white all show three colours. show.<colour> is the inline coloured show (2026-07-29).",
          "match": "\\b(zcolor|say|par|show)((?:\\.(?:font|background|statusline|input|default|black|red|green|yellow|blue|magenta|cyan|white|par|say))+)\\b(?:[ \\t]+(default|black|red|green|yellow|blue|magenta|cyan|white)\\b)?",
          "captures": {
            "1": {
              "name": "keyword.other.statement.storyarc"
            },
            "2": {
              "name": "storage.modifier.storyarc"
            },
            "3": {
              "name": "support.constant.colour.storyarc"
            }
          }
        },
        {
          "comment": "Conversation sugar in a topic body: the player's line, the NPC reply, and the reveal/hide toggles (docs/01 chapter 22).",
          "name": "keyword.other.conversation.storyarc",
          "match": "\\b(you|reply|reveal|hide)\\b"
        },
        {
          "name": "storage.type.storyarc",
          "match": "\\b(list|block|topic)\\b"
        },
        {
          "name": "support.type.metadata.storyarc",
          "match": "\\b(title|headline|author|copyright|release|serial|UUID|scoring|banner)\\b"
        },
        {
          "comment": "Grammar slot words inside a verb declaration's lines (docs/01 chapter 12).",
          "name": "support.type.slot.storyarc",
          "match": "\\b(held|multi)\\b"
        }
      ]
    },
    "calls": {
      "comment": "A block or intrinsic call with arguments: the callee in its own scope, the arguments left to the value scopes (Stefan's policy, 2026-07-04). Bare zero-argument calls are lexically plain names and stay unscoped.",
      "match": "\\b([a-z_][a-z0-9_]*)(?=\\()",
      "name": "entity.name.function.call.storyarc"
    },
    "markers": {
      "comment": "The word-class markers in a words list (docs/01 chapter 14): #word is the object's trigger, >word an adjective. Matched only when glued to the word (or its quoted form), so comparisons stay operators.",
      "match": "(?<=[\\s,])([#>])(?=[A-Za-z\u00c0-\u017f\"])",
      "name": "storage.modifier.marker.storyarc"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.storyarc",
          "match": "\\b(is|not|and|or|holds|in|within|of|mod)\\b"
        },
        {
          "name": "keyword.operator.storyarc",
          "match": "(\\+\\+|--|<=|>=|<|>|\\+|-|\\*|/|=|\\.)"
        }
      ]
    },
    "services": {
      "comment": "The library services an author calls bare or tests with `is`: the cutscene trio (teleport/gain/convey), perform, the worn list, the sight-and-touch predicates. Curated, not exhaustive: the documented author surface only.",
      "name": "support.function.library.storyarc",
      "match": "\\b(teleport|gain|convey|perform|swap|worn_count|list_worn|visible|reachable|calculate|entry|last|dice|position|quote_catalog|parent_of|name_contents|listable_count|press_any_key|action_id|clear_screen|screen_width|screen_height|print_banner|status_bar|confirm_quit|do_quit|do_restart|do_save|do_restore|list_contents|reveal_contents|content_listable|quote_line|quote_done)\\b"
    }
  }
}
