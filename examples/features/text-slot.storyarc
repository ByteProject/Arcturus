// text-slot.storyarc
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// A showcase for the typed input slots (docs/01 chapter 14): a verb's own
// grammar line declares WHAT a machine accepts. `letters` matches letter
// words only, `number` one all-digit word, `anychar` anything, and the
// matcher enforces the class, so a line only fires for its kind of input.
// In the handler the input reads back under the slot's own name:
// ${letters}, ${number}, ${anychar}. Three machines below, one slot each.
// Compile and run:
//
//   arcc examples/features/text-slot.storyarc -o signals.z5
//   frotz signals.z5
//
// TRY: speak xanadu to terminal (the codeword) /
//      speak open sesame to terminal (a two-word literal) /
//      speak swordfish to terminal (the echo refusal) /
//      speak k9 to terminal (not letters: "The terminal only accepts
//      letters.") /
//      set dial to 3 / set dial to 9 (the author's range refuses) /
//      set dial to red (not a number: "The bakelite dial only accepts
//      numbers.") /
//      type hello12323 into keypad (anychar takes it all) /
//      set lamp to 2 (no handler: the ordinary refusal chain answers)

game
    title "The Signal Room"
    headline "A typed-slots showcase"
    author "Stefan Vogt"
    start signals

summon.statusline

room signals
    name "Signal Room"
    desc "Racks of dead receivers. Alive in the middle: a terminal by the
          airlock, a keypad under it, and a bakelite dial numbered 1 to 4.
          A lamp hangs low."

thing terminal in signals
    name "terminal"
    words terminal
    fixed

thing keypad in signals
    name "keypad"
    words keypad
    fixed

thing dial in signals
    name "bakelite dial"
    words dial, bakelite
    fixed
    reading 1
    desc block
        say "Numbered 1 to 4, standing at ${self.reading}."

thing lamp in signals
    name "lamp"
    words lamp
    fixed

// Each line says what its machine accepts; the matcher holds it to that.
verb "speak"
    speak letters to noun

verb "type"
    type anychar into noun

verb "set", "adjust"
    set noun to number

on speak terminal
    // `letters is "..."`: the absorbed words against a literal, one to
    // three words, raw text. The compiler puts the literal's words in the
    // dictionary itself; nothing to declare.
    if letters is "xanadu"
        say "The terminal chirps. The airlock unbolts somewhere out of
             sight."
    else
        if letters is "open sesame"
            say "Charming. The terminal is not amused, but a drawer under
                 it slides open."
        else
            // ${letters} echoes the words exactly as the player wrote them.
            say "The terminal rejects \"${letters}\" with a flat little
                 buzz."

on set dial
    // `number` is the value itself: compare it, store it, print it. The
    // matcher already guaranteed digits, so only the RANGE is yours to
    // police.
    if number > 0
        if number < 5
            change dial.reading to number
            say "The dial clicks to ${number}."
            stop
    say "The dial only goes 1 to 4, not ${number}."

on type keypad
    // anychar takes codes the other classes refuse: letters, digits, or
    // both in one word.
    say "You key in \"${anychar}\". The keypad blinks twice, keeping its
         opinion to itself."
