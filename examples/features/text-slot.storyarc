// text-slot.storyarc
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// A showcase for the text slot's readings (docs/01 chapter 14): an
// author's own verb line carries a `text` slot, and whatever the player
// wrote there reads back under two plain names, `text` (the words,
// compared against a literal or echoed verbatim) and `number` (the same
// input as a number). Keypads, dials, passwords, and every machine with
// an input surface ride the same two readings. Compile and run:
//
//   arcc examples/features/text-slot.storyarc -o signals.z5
//   frotz signals.z5
//
// TRY: type xanadu into terminal (a codeword no dictionary knows) /
//      type open sesame into terminal (a two-word literal) /
//      type swordfish into terminal (the echo refusal) /
//      set dial to 3 / set dial to 9 (out of range) /
//      set dial to fun (not a number) / set lamp to 2 (not settable:
//      the ordinary refusal chain answers)

game
    title "The Signal Room"
    headline "A text-slot showcase"
    author "Stefan Vogt"
    start signals

summon.statusline

room signals
    name "Signal Room"
    desc "Racks of dead receivers. Alive in the middle: a terminal by the
          airlock and a bakelite dial numbered 1 to 4. A lamp hangs low."

thing terminal in signals
    name "terminal"
    words terminal
    fixed

thing dial in signals
    name "bakelite dial"
    words dial, bakelite
    fixed
    reading 1
    desc block
        say "Numbered 1 to 4, standing at ${self.reading}."

thing lamp in signals
    name "lamp"
    words lamp
    fixed

// The grammar is the author's: any verb, any line, `text` where the free
// words go. The slot absorbs what was typed without resolving it against
// objects, so a codeword needs no thing and no vocabulary.
verb "type"
    type text into noun

verb "set", "adjust"
    set noun to text

on type terminal
    // `text is "..."`: the absorbed words against a literal, one to three
    // words, raw text. The compiler puts the literal's words in the
    // dictionary itself; nothing to declare.
    if text is "xanadu"
        say "The terminal chirps. The airlock unbolts somewhere out of
             sight."
    else
        if text is "open sesame"
            say "Charming. The terminal is not amused, but a drawer under
                 it slides open."
        else
            // ${text} echoes the words exactly as the player wrote them.
            say "The terminal rejects \"${text}\" with a flat little
                 buzz."

on set dial
    // `number`: the same input as a number (up to four digits); anything
    // else reads 0, so one comparison covers both the wrong range and the
    // not-a-number case. The refusal echoes through ${text}: an echo is
    // words, whatever was typed.
    if number > 0
        if number < 5
            change dial.reading to number
            say "The dial clicks to ${number}."
            stop
    say "The dial has no setting called \"${text}\"."
