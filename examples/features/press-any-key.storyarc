// press-any-key.storyarc
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// A showcase for waiting on a single keypress, in its three manners:
//
// 1. THE PACING GATE, the classic "press any key" between paragraphs
//    (Hibernated 2 does this after its intro): the library helper
//    `press_any_key` prints the prompt and waits. The prompt is
//    msg_press_any_key in the language layer, "[...]" by default:
//    convenient, understood everywhere, no translation needed, and a
//    story or a language pack overrides the block to reword it.
// 2. THE CUSTOM PROMPT, an in-game device asking in its own voice: call
//    `read_key` directly (one keypress, no echo, no Enter, backed by
//    the Z-machine's read_char) after saying whatever the scene needs.
// 3. THE SPECIFIC KEY: `read_key` is also a value returning the key's
//    ZSCII code, so a device can accept exactly the keys it names,
//    refuse the rest, and ask again.
//
// Compile and run:
//
//   arcc examples/features/press-any-key.storyarc -o press-any-key.z5
//   frotz press-any-key.z5
//
// Try, in order:
//   (at the start)     manner 1: the intro pauses on "[...]" until any
//                      key falls, then the story continues
//   read plaque        manner 1 again, mid-game: each "[...]" turns the
//                      page (READ is examine's standard synonym)
//   press panel        manner 3: the panel names A and B, takes exactly
//                      those, refuses everything else and asks again
//                      (PRESS rides push's grammar)
//   touch globe        manner 2: a custom prompt in the device's own
//                      voice, any key accepted

game
    title  "The Anteroom"
    headline "A press-any-key showcase"
    author "Stefan Vogt"
    start  anteroom

summon.statusline

on start
    say "Dust settles in a cone of lamplight. Somewhere behind the wall,
         machinery clears its throat."
    press_any_key
    say "A door you had not noticed unbolts itself."

room anteroom
    name "The Anteroom"
    desc "A waiting room for something larger. A bronze plaque, a lettered
          panel, and a milky glass globe share the far wall."

thing plaque in anteroom
    name "bronze plaque"
    words plaque, >bronze
    fixed
    desc "Three lines of small bronze capitals. Reading them feels like
          being read to."

    on examine
        say "THE MACHINE REMEMBERS."
        press_any_key
        say "THE MACHINE FORGIVES."
        press_any_key
        say "THE MACHINE IS PATIENT."

thing panel in anteroom
    name "lettered panel"
    words panel, >lettered
    fixed
    desc "Two brass keys, A and B, worn shiny."

    on push
        say "The panel lights two keys: A and B."
        let k = 0
        while k is not 97 and k is not 98
            change k to read_key
            if k is not 97 and k is not 98
                say "A flat click. Only A or B will do."
        if k is 97
            say "A soft chime: corridors realign somewhere below."
        else
            say "A low horn: the lift arrives, empty."

thing globe in anteroom
    name "glass globe"
    words globe, >glass
    fixed
    desc "Milky glass, faintly warm, waiting to be consulted."

    on touch
        say "The globe clouds over. \"WHEN YOU ARE COMPOSED,\" it prints
             across its own fog, \"TOUCH ANY KEY.\""
        read_key
        say "The fog clears, satisfied with your composure."
