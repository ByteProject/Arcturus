// conversations.granule
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// summon.conversations: the menu presentation of the `topic` model, after the
// look of PunyInform's talk menu (which is the right idea) but on Arcturus's
// topic sugar instead of its hand-managed talk arrays. TALK TO a person and a
// numbered menu of their topics in view is painted in the upper window, held
// STATIC while the conversation scrolls in the main window below. Press a number
// to ask that topic; the exchange prints below and the topic drops off the menu
// (you have discussed it), which redraws with any topics the exchange revealed.
// 0 or ENTER ends it and the menu folds away.
//
// This is the same `topic` model the extendedverbs ask/tell path walks; the two
// are mutually exclusive views of one thing (the menu wins). To change the menu
// wording or layout, override the blocks from the story or fork the granule.
// (The conversation line framing - line_you,
// line_reply, line_end - lives in the prelude, not here, so that part stays
// overridable from a story and translatable by a language pack.)

// The menu's screen state, granule-owned (pay-for-use): the split height
// while a menu stands (0 closed), and the visibility mask count_visible
// filled on its last walk, one bit per topic for the first sixteen, so
// draw_menu and run_pick reuse the when-guard answers instead of running
// every topic's guards again per walk (the 8-bit cycle work, 2026-09-01;
// topics beyond sixteen fall back to the live test, correct, just unclever).
global menu_h = 0
global menu_vis = 0

// Override the base talk_to seam: talking to a person opens the topic menu.
block talk_to(person)
    run_talk(person)

// ASK (and a stray ANSWER) land in the menu through the base seams, which
// hand over to talk_to; overriding talk_to above was enough, so ASK VLAD
// opens Vlad's menu and the subject words of "ask vlad about the vines"
// ride along harmlessly. TELL is not asking: it answers with the gentle
// use-TALK hint (msg_use_talk, in the language layer). The words and
// grammar are the standard ask/tell from the language pack; this granule
// holds no words and no strings.
block tell_to(person)
    change refused to 1
    msg_use_talk

block run_talk(person)
    if count_visible(person) is 0
        msg_no_topics
        return 0
    let going = 1
    while going is 1
        let count = count_visible(person)
        if count > 9
            change count to 9
        if count is 0
            close_menu
            msg_talk_over
            change going to 0
        else
            draw_menu(person, count)
            let pick = menu_choice(count)
            if pick is 0
                close_menu
                msg_talk_over
                change going to 0
            else
                set_window(0)
                run_pick(person, pick)

// Paint the numbered menu in the upper window and hold it static there, sized to
// the topics in view rather than reserving a fixed slice of the screen the way
// PunyInform's talk menu does - a small dynamic refinement on the same idea.
// Layout, top to bottom with no gaps: the status bar (only when statusline is
// summoned), the header, the topics, the prompt, and a divider rule at the bottom
// border. status_lines tells us whether a bar row is present, so without
// statusline the menu reclaims row 1 and uses the full window. The double erase,
// around the resize, keeps a shrinking menu from leaving a stale line behind: the
// first clears the old (possibly taller) window, the second the new one. Single
// keypress selection caps the list at nine, so a tenth topic waits for a discard.
// A topic the menu should list: in view, and not an `idle` fallback (idle
// topics belong to the ask/tell presentation and are invisible here, docs/01 chapter 22).
// The idle test folds away in a game with no idle topic (any_topic_idle).
block menu_visible(person, i)
    if topic_visible(person, i) is 0
        return 0
    if any_topic_idle is 1
        if topic_idle(person, i) is 1
            return 0
    return 1

block draw_menu(person, count)
    // HOLD the pending paragraph break across the menu draw: it belongs to the
    // lower window's next text, and the menu's prints must not consume it.
    let held = par_pending
    change par_pending to 0
    // Unbuffered while the menu paints (restored at set_window(0) below), or
    // buffering interpreters reorder the writes around set_cursor.
    buffer_mode(0)
    let w = screen_width
    if w is 0
        change w to 40
    let top = status_lines
    let h = top + count + 3
    set_window(1)
    if menu_h is 0
        // OPENING: split taller and keep the bar row exactly as the prompt
        // painted it, so the bar is never repainted for a menu at all (the
        // close's re-seat is the one legitimate repaint). No window erase:
        // every row the menu owns is line-erased right before its print
        // below, and together with the header they cover every freshly
        // exposed row, gaplessly. The reservation bookkeeping still moves
        // to the menu while it stands.
        split_window(h)
        bar_unseated
        set_cursor(top + 1, 1)
        erase_line
        line_talk_header(person)
    else
        // REDRAW after a pick: the bar row and the header have not moved
        // and are not touched, so the bar paints once per conversation,
        // not once per exchange. A shrinking menu erases its dead rows
        // while the window is still tall; every row below the header is
        // then rewritten in place with a line erase, no window erase at
        // all (the 8-bit cycle work, 2026-09-01).
        if h < menu_h
            let r = h + 1
            while r <= menu_h
                set_cursor(r, 1)
                erase_line
                change r to r + 1
        split_window(h)
    let i = 0
    let n = 0
    let tc = topics_count(person)
    let bit = 1
    while i < tc
        if vis_at(person, i, bit) is 1
            if n < count
                change n to n + 1
                set_cursor(top + 1 + n, 1)
                erase_line
                set_cursor(top + 1 + n, 2)
                show(n)
                show(". ")
                topic_label(person, i)
        if i < 16
            change bit to bit * 2
        change i to i + 1
    set_cursor(h - 1, 1)
    erase_line
    line_talk_prompt
    set_cursor(h, 1)
    erase_line
    let d = 1
    while d < w
        show("-")
        change d to d + 1
    change menu_h to h
    set_window(0)
    buffer_mode(1)
    change par_pending to held

// Read keypresses until a valid one: a digit 1..count returns it; 0, ENTER, or Q
// ends the conversation (returns 0). Other keys are ignored and read again, so a
// stray key neither redraws nor exits.
block menu_choice(count)
    while true
        let key = read_key
        if key is 13
            return 0
        if key is 48
            return 0
        if key is 81
            return 0
        if key is 113
            return 0
        let pick = key - 48
        if pick >= 1
            if pick <= count
                return pick

// Fold the menu away and return the whole screen to the conversation.
block close_menu()
    erase_window(1)
    split_window(0)
    // No upper window at all now: the next prompt's bar reserves its row again.
    bar_unseated
    set_window(0)
    change menu_h to 0

block count_visible(person)
    let tc = topics_count(person)
    let i = 0
    let n = 0
    let bit = 1
    change menu_vis to 0
    while i < tc
        if menu_visible(person, i)
            change n to n + 1
            if i < 16
                change menu_vis to menu_vis + bit
        if i < 16
            change bit to bit * 2
        change i to i + 1
    return n

// The cached visibility for topic i: the bit count_visible set, or the live
// test beyond the mask's sixteen. Valid between a count and the draw or the
// pick that follows it, which is exactly how run_talk sequences the three.
block vis_at(person, i, bit)
    if i < 16
        let v = menu_vis / bit
        return v mod 2
    return menu_visible(person, i)

// Run the pick-th visible topic (counting from 1, in declaration order, as
// draw_menu numbered them), then retire it so it leaves the menu.
block run_pick(person, pick)
    let tc = topics_count(person)
    let i = 0
    let n = 0
    let bit = 1
    while i < tc
        if vis_at(person, i, bit) is 1
            change n to n + 1
            if n is pick
                topic_run(person, i)
                topic_retire(person, i)
                return 0
        if i < 16
            change bit to bit * 2
        change i to i + 1

// The conversation wording (line_talk_header, line_talk_prompt, msg_no_topics,
// msg_talk_over) lives in the language layer so a pack translates it.
