//
// The pathfinding granule's ENGLISH wording and grammar: the loader adds
// this companion automatically when summon.pathfinding meets an English
// game (docs/01 chapter 22, language companions). The logic lives in
// pathfinding.granule; translate THIS file's twin for a new language.

// GO TO rides the standard go verb; FIND is its own verb and also answers
// LOOK FOR; LOOK <direction> joins the look verb.

enhance verb "go"
    goto_room to text

verb "find", "locate"
    find_where text

enhance verb "look"
    look_way direction
    find_where for text

block line_stride()
    say "(through ${the here})"

block line_seek_notice(r)
    say "(setting off for ${the r})"

block msg_already_there()
    say "You are already there."

block msg_no_way_known()
    say "You don't know the way there."

block msg_unknown_place()
    say "You don't know that place."

block msg_seek_unknown()
    say "You don't know of any such thing."

block msg_find_here(o)
    say "${The o} is right here."

block msg_seek_near(o)
    say "${The o} should be somewhere close by."

block msg_nothing_that_way()
    say "Nothing lies that way."

block msg_door_shut_way(d)
    let at = dir_word_at
    if at is 0
        say "That way lies ${the d}, closed."
        return 0
    show_dir_word(at, 1)
    say " lies ${the d}, closed."

block msg_way_lies(d)
    let at = dir_word_at
    if at is 0
        say "That way lies ${the d}."
        return 0
    show_dir_word(at, 1)
    say " lies ${the d}."

block msg_way_unknown()
    let at = dir_word_at
    if at is 0
        say "That way is open, but you haven't been to see."
        return 0
    show("The way ")
    show_dir_word(at, 0)
    say " is open, but you haven't been that way yet."
