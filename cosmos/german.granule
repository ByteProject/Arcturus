block msg_part_of()
    let p = parent_of(noun)
    show("Das gehört zu ")
    art_the(p, 0, 2)
    say "."

block msg_dropped()
    // Nested, the line says where to (accusative: auf den Altar, in die
    // Kiste). Omitted without enterable things.
    if any_enterable is 1
        if parent_of(player) is not here
            if parent_of(player) is supporter
                show("Fallen gelassen, auf ")
            else
                show("Fallen gelassen, in ")
            art_the(parent_of(player), 0, 1)
            say "."
            return 0
    say "Fallen gelassen."

