// german.granule
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// THE GERMAN LANGUAGE LAYER (informal, du). A language pack, selected with
// `summon.language "german"`, which compiles it in place of english.prelude. A
// fork of the English layer: the language-agnostic parser logic in section 1 is
// unchanged; the verbs, the direction words, the articles, and every message are
// German. The message set has had a native pass (Stefan Vogt, 2026-07). It has
// three parts, in order:
//
//   1. THE PARSER - the blocks that teach the parser how to read German input:
//      which word is the verb, how a noun phrase is matched, how directions and
//      particles are recognized, and the oops correction. The language-agnostic
//      skeleton that drives these lives in parser.prelude; these are its hooks.
//   2. THE STANDARD VERBS - the vocabulary: every standard verb word and its
//      grammar. The behaviour behind each action is agnostic and lives in
//      actions.prelude, keyed by action name; only the words are here.
//   3. THE MESSAGES - every line the library prints to the player, each an
//      overridable block, plus the room and content listing that frames them.
//
// Two things set German apart from the Spanish pack, and shape this file:
//   - GENDER is three-way (der/die/das) with no spelling rule, so the author
//     declares the article on the object (der/die/das); the compiler maps that to
//     the feminine/neutral attributes this file reads. Masculine is the default.
//   - The article INFLECTS FOR CASE (der/den/dem). A message asks for the case it
//     needs with a tag on the article, ${the:acc noun} / ${a:dat noun}; art_the
//     and art_a below turn gender and case into the right word. Predicate
//     adjectives do NOT inflect ("die Kiste ist offen", "der Schrank ist offen"),
//     so unlike Spanish there are almost no per-gender message variants: the
//     article changes in one place. The exception is a PRONOUN that refers back
//     to the noun (msg_fixed: wo sie/er/es ist), which branches on the gender.
//
// TYPING ON 8-BIT HARDWARE: an accented word is shown in full (the interpreters
// render umlauts and ß), but every word the player must TYPE also needs a plain
// ASCII form, since an 8-bit keyboard cannot enter umlauts. The fold table
// below does that automatically: every dictionary word containing ä/ö/ü/ß,
// this pack's and the game's own words alike, gains its crossword sibling
// (tuer for tür, spass for Spaß) as a second entry with the same meaning.
// Declare the proper spelling once; the folded one is derived. One-way by
// design: not every "ue" is a "ü", so the reverse would guess.
//
// The self-identifying marker: this is the language pack for the code "german".
// The compiler requires it to be chosen with summon.language, and rejects a plain
// `summon german.granule` (which would leave English baked in).
language "german"

// The crossword fold table (docs/01 chapter 21): one pair per line.
fold "ä" "ae"
fold "ö" "oe"
fold "ü" "ue"
fold "ß" "ss"

// ==========================================================================
// 1. THE PARSER
// How input becomes a verb, its nouns, and a direction. Agnostic logic: this
// section is identical to the English and Spanish skeletons, and is here only
// because a language pack replaces english.prelude wholesale.
// ==========================================================================

// Resolve the verb: the first word, if its dictionary entry is flagged a verb.
// Returns the action number, or 0 if the first word is not a known verb.
block resolve_verb()
    let d = word_dict(0)
    if d is not nothing
        let flags = peek_byte(d + 6)
        if any_tables is 1
            // A tabled verb (docs/01 chapter 14): the data bytes carry
            // the table's address, whose first byte is the first line's
            // action; the actual line is chosen later by the matcher
            // (line_act).
            if flags is 144 or flags is 152
                let tbl = peek_word(d + 7, 0)
                return peek_byte(tbl)
        if flags is 128 or flags is 136
            let base = peek_byte(d + 7)
            let p = find_particle
            if p is not nothing
                let c = compound(base, p)
                if c is not nothing
                    return c
            return base
        if flags is 64
            return peek_byte(d + 7)
    // No verb up front? If a direction stands anywhere in the line, it is
    // still a go command: that is how "nach oben" and "nach unten" parse,
    // where the first word ("nach") is not even in the dictionary.
    if find_direction is not nothing
        return action_id("go")
    return 0

// The first verb-particle word in the command, as its id (an/ein 1, aus/ab 2,
// auf 3, zu 4, declared with `particle` below). This is what makes the trennbare
// Verben work: "schalt die Lampe an" and "schliess die Tuer auf" find their
// particle here, wherever it falls, and compound maps base verb + particle to
// the real action.
block find_particle()
    let n = word_count
    let i = 1
    while i < n
        let d = word_dict(i)
        if d is not nothing
            if peek_byte(d + 6) is 32
                return peek_byte(d + 7)
        change i to i + 1
    return nothing

// Combine a base verb with a particle into a multi-word action. The particle ids
// are the shared contract with the compiler (prelude._PARTICLE_ROLES): 1 on
// (an/ein), 2 off (aus/ab), 3 auf, 4 zu. The same word can mean different things
// after different base verbs, and this block is where that is resolved.
block compound(base, particle)
    if base is action_id("switch_on")   // schalt(e): + an/ein an, + aus/ab aus
        if particle is 1
            return action_id("switch_on")
        if particle is 2
            return action_id("switch_off")
    if base is action_id("close")        // schliess(e): + auf auf, + zu/ab ab
        if particle is 3
            return action_id("unlock")
        if particle is 4
            return action_id("lock")
        if particle is 2
            return action_id("lock")
    if base is action_id("turn")
        if particle is 1
            return action_id("switch_on")
        if particle is 2
            return action_id("switch_off")
    if base is action_id("take")         // nimm ... ab -> ausziehen (take_off)
        if particle is 2
            // Not with ALLES: "nimm alles aus der Kiste" is the takeall
            // granule's sweep, not undressing. The guard folds away
            // without the granule.
            if any_allwords is 1
                if all_typed is 1
                    return nothing
            return action_id("take_off")
    if base is action_id("transcript")   // mitschrift an / mitschrift aus
        if particle is 1
            return action_id("transcript")
        if particle is 2
            return action_id("transcript_off")
    if base is action_id("look")         // schau unter den teppich
        if particle is 5
            return action_id("look_under")
    return nothing

// The chosen direction's property number, from the first direction word typed
// (a direction word's dictionary entry is flagged with bit 6, and byte 2 holds
// the direction property). Returns nothing if no direction was named.
block find_direction()
    let n = word_count
    let i = 0
    while i < n
        let d = word_dict(i)
        if d is not nothing
            if peek_byte(d + 6) is 64
                return peek_byte(d + 8)
        change i to i + 1
    return nothing

// German reads SCHAU <noun> as EXAMINE, the usual synonym: a bare SCHAU describes
// the room, while SCHAU MANTEL inspects the cloak. parser.prelude calls this once
// the objects are known; here it remaps the look action to examine when a noun or
// a scenery grain was named.
block remap_action(act)
    if act is action_id("look")
        if noun is not nothing
            return action_id("examine")
        if grain is not 0
            return action_id("examine")
    return act

// Does the object's vocabulary include this dictionary word?
block has_word(obj, target)
    let addr = words_addr(obj)
    if addr is nothing
        return 0
    let count = words_count(obj)
    let i = 0
    while i < count
        if peek_word(addr, i) is target
            return 1
        change i to i + 1
    return 0

// Can the player see and reach what is inside this object? A supporter's
// contents are always in view. A container's are in view when it is open, when
// it is `clear` (see-through), or when it is not `openable` at all: a bowl or a
// basket has no lid to shut, so its contents are always reachable.
block see_into(obj)
    if obj is supporter
        return 1
    if obj is container
        if obj is open
            return 1
        if obj is clear
            return 1
        if obj is not openable
            return 1
    return 0

// A closed opaque container: we cannot see into it.
block shut_holds(obj)
    if obj is open
        return 0
    if obj is clear
        return 0
    if obj is not openable
        return 0
    return 1

// Among the closed opaque containers directly within `where`, a known (seen)
// content matching the word. Records the blocking container in shut_in.
block shut_search(where, target)
    for each obj in where
        if obj is not hidden
            if obj is container
                if shut_holds(obj)
                    let known = shut_match(obj, target)
                    if known is not nothing
                        change shut_in to obj
                        return known
    return nothing

block shut_match(holder, target)
    for each x in holder
        if x is not hidden
            if x is seen
                if has_word(x, target)
                    return x
    return nothing

// Match a noun: the typed words after the verb, as one phrase, through the
// scoring matcher (parser.prelude match_phrase): the in-scope object matching
// the most typed words wins, a tie is a genuine ambiguity (parse_fault 3).
block match_noun()
    return match_first_phrase

// Resolve the command's objects into the noun (and, for a two-noun verb, the
// second). The verb's dictionary entry carries its noun arity in data byte 2.
block resolve_objects()
    // The adjective ending strip first, so a declined form ("roten") is a
    // known word before anything matches. Folds away without > markers.
    if any_adjectives is 1
        strip_endings
    change noun to nothing
    change second to nothing
    change grain to 0
    change parse_fault to 0
    change two_reverse to 0
    if any_swap is 1
        change two_swap to 0
    if any_tables is 1
        change line_act to 0
    // The verb's requirement bits (the grammar byte): rq1 means no line
    // works without a slot, so the bare verb is an incomplete command; rq2
    // means every slotted line wants two. Both feed the loop's central ask
    // (incomplete).
    let rq1 = 0
    let rq2 = 0
    let d = word_dict(0)
    if d is not nothing
        if any_tables is 1
            // A tabled verb: the positional matcher takes over the whole
            // command (docs/01 chapter 14).
            if peek_byte(d + 6) is 144 or peek_byte(d + 6) is 152
                let tbl = peek_word(d + 7, 0)
                grammar_match(tbl)
                return 1
        if peek_byte(d + 6) is 128 or peek_byte(d + 6) is 136
            let arity = peek_byte(d + 8)
            let va = peek_byte(d + 7)
            // Bit 5: this verb's prepositional two-noun form binds swapped
            // (GIESSE X IN Y fuellt Y); resolve_two_nouns does the swap.
            if any_swap is 1
                if arity >= 32
                    change two_swap to 1
                    change arity to arity - 32
            if arity >= 16
                change rq2 to 1
                change arity to arity - 16
            if arity >= 8
                change rq1 to 1
                change arity to arity - 8
            // A reverse-capable two-noun verb (geben/zeigen) is encoded as 6:
            // the recipient-first order (gib Bob die Muenze) with no preposition,
            // the natural German dative, splits and swaps in resolve_two_nouns.
            if arity is 6
                change two_reverse to 1
                change arity to 2
            if arity is 2
                // A da-word pre-fills the second slot and satisfies the
                // requirement ("leg das buch darauf" stops asking wohin).
                if bind_daword is 1
                    if parse_fault is not 0
                        return 1
                resolve_two_nouns(rq1, rq2)
                return 1
            if arity is 0
                if va is not action_id("oops")
                    if has_extra_words(va) is 1
                        change parse_fault to 2
                return 1
    change noun to match_noun
    // An ambiguity fault (3) stands: falling through to the grain and
    // unseen checks would overwrite the honest "which do you mean".
    if parse_fault is not 0
        return 1
    // A pending plural sweep ("take coins", THEM) binds per object later.
    if any_plurals is 1
        if plural_go is not 0
            return 1
    if noun is nothing
        // A da-form under-compound with an empty slot ("schau darunter"):
        // the freshest thing fills it, the same referent damit binds. Only
        // when the particle really compounds to look_under, so "nimm
        // darunter" keeps its ordinary refusal.
        let d0 = word_dict(0)
        if d0 is not nothing
            if peek_byte(d0 + 6) is 128 or peek_byte(d0 + 6) is 136
                if find_under_particle is 1
                    if compound(peek_byte(d0 + 7), 5) is action_id("look_under")
                        change noun to da_referent(nothing)
                        if noun is nothing
                            change parse_fault to 5
                        return 1
    if noun is nothing
        change noun to reach_unscoped
        if any_reach is 1
            if noun is not nothing
                change reached to 1
    if noun is nothing
        change grain to find_scenery
        if grain is 0
            change parse_fault to named_unseen
            if parse_fault is 0
                change unknown_at to first_unknown(1, word_count)
                if unknown_at is not 0
                    change parse_fault to 4
            // Nothing typed for a slot the grammar requires (the bare
            // NIMM): incomplete, and the loop asks before any handler
            // runs. A fault takes precedence.
            if parse_fault is 0
                if rq1 is 1
                    change incomplete to 1
    return 1

// The reach_unscoped seam (docs/01 chapter 14): the parser's escape hatch
// for a verb that legitimately names something out of scope (FOLLOW the
// classic). Called only after ordinary matching failed; return an object to
// bind it as the noun, nothing to keep the honest refusal. A verb that
// reaches owns its own validity in its handler, AGAIN included (the replay
// skips the left-scope refusal for a reach-bound noun). The debug granule's
// fetch/warp verbs are the library's own use of the seam.
block reach_unscoped()
    if any_debug is 1
        return reach_try_debug
    if any_maniacswap is 1
        return reach_swap
    return nothing

// The debug leg lives in its own block so reach_unscoped never carries
// its local: a let in a statically-dead branch still allocates the slot
// (the locals-count byte), the one byte that would break the identity of
// every game (the dead-branch-let lesson, again).
block reach_try_debug()
    let r = reach_debug
    if r is not nothing
        return r
    if any_maniacswap is 1
        return reach_swap
    return nothing

// Did the player name an object word that nothing in scope answered to?
block named_unseen()
    return phrase_named(1, word_count)

// For an intransitive verb (no noun slot), is there a word after it the grammar
// cannot use? A go command is the exception: there, all that counts is a
// direction standing somewhere, since "geh nach oben" carries the filler
// "nach", which is not even in the dictionary.
block has_extra_words(act)
    if act is action_id("go")
        if find_direction is not nothing
            return 0
    let n = word_count
    let i = 1
    while i < n
        let keep = 0
        let d = word_dict(i)
        // A particle that compounds with this verb belongs to the verb
        // ("mitschrift an"); any other word is one too many.
        if d is not nothing
            if peek_byte(d + 6) is 32
                if compound(act, peek_byte(d + 7)) is not nothing
                    change keep to 1
        if keep is 0
            return 1
        change i to i + 1
    return 0

// A scenery grain word (flagged bit 4) whose owner is in scope; returns the
// grain id.
block find_scenery()
    // The walker folds away entirely (any_grains is a compile-time flag) in a
    // game that declares no grains, so unused scenery costs nothing.
    if any_grains is 1
        let n = word_count
        let i = 1
        while i < n
            let d = word_dict(i)
            if d is not nothing
                if peek_byte(d + 6) is 16
                    // The word's grain chain: (grain id, owner) pairs, zero-
                    // ended. The same word can be scenery in several rooms;
                    // answer with the grain whose owner is in scope here.
                    let g = grain_from_chain(peek_word(d + 7, 0))
                    if g is not 0
                        return g
                else
                    // A DUAL-ROLE word (LIGHT the verb, LIGHT the scenery):
                    // the command owns the flag byte, and the side table
                    // carries the grain chain. Folds away without one.
                    if any_duals is 1
                        let dt = duals_table
                        let k = peek_word(dt, 0)
                        let m = 0
                        while m < k
                            if peek_word(dt, 1 + m * 2) is d
                                let g2 = grain_from_chain(peek_word(dt, 2 + m * 2))
                                if g2 is not 0
                                    return g2
                                change m to k
                            else
                                change m to m + 1
            change i to i + 1
    return 0

// Is this dictionary word a phrase boundary rather than a noun word?
block is_separator(target)
    // Only the words that JOIN two nouns split the phrases: a grammar
    // preposition (flag 8), and the direction and particle words that
    // double as one ("put coin IN box", "gib X AN Y", flags 64 and 32).
    // Anything else is content: a pronoun binds as a noun, an article is
    // skipped, and a noun that moonlights as a verb elsewhere ("pick the
    // LOCK", "PAT the person") must not end the phrase it stars in.
    if peek_byte(target + 6) is 8 or peek_byte(target + 6) is 136
        return 1
    if peek_byte(target + 6) is 64
        return 1
    if peek_byte(target + 6) is 32
        return 1
    return 0

// The one-noun retry: a separator can be part of ONE name ("Tuer aus
// Eiche"), and the split then reads the words behind it as an instrument
// nobody meant ("oeffne tuer aus eiche" asked about the second slot).
// When a split slot comes up ambiguous or empty and the grammar does not
// require a second noun, the whole typed range gets ONE try as a single
// noun: a clean resolve wins and the second slot stays shut. Anything
// less restores the split's own outcome, ask included, so "gib muenze an
// bob" and every genuine ambiguity behave exactly as before.
block one_noun_retry(n)
    let keep_fault = parse_fault
    let keep_lo = ask_lo
    let keep_hi = ask_hi
    let keep_score = ask_score
    let keep_at = ask_at
    let keep_unknown = unknown_at
    change parse_fault to 0
    let w = match_phrase(1, n, 0)
    if parse_fault is 0
        if w is not nothing
            change noun to w
            change second to nothing
            return 1
    change parse_fault to keep_fault
    change ask_lo to keep_lo
    change ask_hi to keep_hi
    change ask_score to keep_score
    change ask_at to keep_at
    change unknown_at to keep_unknown
    return 0

// Bind the two noun slots by position: the words before the preposition name the
// first noun, the words after it name the second.
block resolve_two_nouns(rq1, rq2)
    let n = word_count
    // A second slot pre-filled by a da-word (bind_daword): the rest of the
    // line is ONE noun, no split, and the da-word already satisfied the
    // two-noun requirement, so only a missing FIRST noun still asks.
    if second is not nothing
        change noun to match_phrase(1, n, 0)
        if parse_fault is not 0
            return 1
        // The noun turned out to BE the bound referent (nimm das buch, leg
        // das buch darauf: the book is the freshest mention): repick,
        // excluding it, so darauf means the table it must mean.
        if second is noun
            change second to da_referent(noun)
            if second is nothing
                change parse_fault to 5
                return 1
        if noun is nothing
            if n > 1
                change grain to find_scenery
                if grain is not 0
                    return 1
                change parse_fault to noun_fault(1, n)
                return 1
            if rq1 is 1
                change incomplete to 1
        return 1
    let b = 0
    let i = 1
    while i < n
        if b is 0
            let d = word_dict(i)
            if d is not nothing
                if is_separator(d)
                    change b to i
        change i to i + 1
    // The reversed dative (gib Bob die Muenze), the natural German order: two
    // adjacent nouns, no "an" to split on. Probe each boundary for the first
    // where both sides name a single object, then bind them swapped (recipient
    // first, thing second). No clean split falls through to the ordinary path.
    if two_reverse is 1
        if b is 0
            let sp = 2
            while sp < n
                let recip = probe_noun(1, sp)
                if recip is not nothing
                    let gift = probe_noun(sp, n)
                    if gift is not nothing
                        change second to recip
                        change noun to gift
                        return 1
                change sp to sp + 1
    if b is 0
        change b to n
    change noun to match_phrase(1, b, 0)
    if parse_fault is not 0
        // The first slot is ambiguous although words follow the
        // separator: try the one-noun reading first (one_noun_retry).
        if parse_fault is 3
            if b < n
                if rq2 is 0
                    if one_noun_retry(n) is 1
                        return 1
        return 1
    // A named-but-unresolved noun (a known object out of scope, an unknown word,
    // a stray non-noun) faults so the turn is rejected rather than run with no
    // noun; an EMPTY slot (b is 1, das nackte GIB) is incomplete when the
    // grammar requires the noun (rq1): the loop asks before any handler.
    if noun is nothing
        if b > 1
            if b < n
                if rq2 is 0
                    if one_noun_retry(n) is 1
                        return 1
            // A scenery grain answers a two-slot verb's one-noun form too
            // (BURN DUST): same fallback the single-noun path takes.
            change grain to find_scenery
            if grain is not 0
                return 1
            change parse_fault to noun_fault(1, b)
            return 1
        if rq1 is 1
            change incomplete to 1
    if b < n
        change second to match_phrase(b + 1, n, 0)
        if parse_fault is not 0
            // The second slot is ambiguous ("eiche" hits Truhe AND
            // Tuer): the one-noun reading may still avert the ask.
            if parse_fault is 3
                if rq2 is 0
                    if one_noun_retry(n) is 1
                        return 1
            return 1
        if second is nothing
            if b + 1 < n
                if rq2 is 0
                    if one_noun_retry(n) is 1
                        return 1
                change parse_fault to noun_fault(b + 1, n)
            else
                if rq2 is 1
                    change incomplete to 1
    else
        // No separator ("leg lampe"): the second slot stayed shut. A
        // verb with a one-slot line (schliess tuer auf) stays quiet
        // (rq2 is 0).
        if rq2 is 1
            // The reversed dative's blind spot, same as the English
            // resolver: ZEIG GAUKLER PUPPE with the Puppe elsewhere.
            // The probe wins only when both sides resolve, so the
            // fall-through matched the Gaukler alone. A residual word
            // naming a real thing answers can't-see, an unknown word is
            // spelled back; only a bare "zeig gaukler" keeps the ask.
            if noun is not nothing
                let rw = 1
                while rw < n
                    let rwd = word_dict(rw)
                    if rwd is nothing
                        change unknown_at to rw
                        change parse_fault to 4
                        return 1
                    let claim = 0
                    if has_word(noun, rwd)
                        change claim to 1
                    if any_plurals is 1
                        if has_plural(noun, rwd) is 1
                            change claim to 1
                    if claim is 0
                        if peek_byte(rwd + 6) is 0
                            change parse_fault to 1
                            return 1
                    change rw to rw + 1
            change incomplete to 1
    // The reversed prepositional line (the summary byte's bit 5, decoded
    // into two_swap): the typed order binds swapped, so the vessel lands
    // in the noun slot. Only a fully bound pair swaps; folds away without
    // a reversed prepositional verb (any_swap).
    if any_swap is 1
        if two_swap is 1
            if noun is not nothing
                if second is not nothing
                    // b (the split boundary) is spent once both slots are
                    // bound; reusing it keeps the routine's local count
                    // unchanged, so games without the fold stay
                    // byte-identical (a let would cost the slot even
                    // inside the folded branch).
                    change b to noun
                    change noun to second
                    change second to b
    return 1

// Remember the command just parsed so a following "oops" can correct it.
block note_oops()
    change oops_ready to 0
    let n = word_count
    let i = 0
    while i < n
        if word_dict(i) is nothing
            change oops_word to i
            change oops_ready to 1
            copy_bytes(parse_addr, oops_addr, 2 + 4 * n)
            return 0
        change i to i + 1
    return 0

// Correct the previous command's unrecognized word with the word typed after
// "oops", then re-resolve the patched command and return its action.
block fix_oops()
    if oops_ready is 0
        msg_cant_oops
        return 0
    let fix = word_dict(1)
    if fix is nothing
        msg_cant_oops
        return 0
    copy_bytes(oops_addr, parse_addr, 2 + 4 * peek_byte(oops_addr + 1))
    poke_word(parse_addr, 1 + 2 * oops_word, fix)
    let act = resolve_verb
    if act is 0
        return 0
    if any_verb_read is 1
        change verb_trigger to word_dict(0)
    change tie_want to 1
    if act is action_id("take")
        change tie_want to 0
    change way to find_direction
    resolve_objects
    if parse_fault is 1
        msg_cant_see
        return 0
    if parse_fault is 3
        msg_be_specific
        return 0
    if any_tables is 1
        if line_act is not 0
            change act to line_act
    return act

// ==========================================================================
// 2. THE STANDARD VERBS
// The verb vocabulary and grammar; the logic is in actions.prelude. Informal
// address (du). Every umlaut/ss word is paired with its plain ASCII form so an
// 8-bit keyboard can type it.
// ==========================================================================

// Bare SCHAU describes the room; SCHAU <noun> is the usual synonym for EXAMINE,
// remapped once the noun is known (remap_action above).
verb "schau", "schaue", "sieh", "l"
    look
    look noun

// Movement. The parser sets `way` to the chosen direction's property. A room can
// override one direction with its own `on go <direction>`.
verb "geh", "gehe", "gehen", "lauf", "laufe", "renne"
    go

// The direction words: each maps its vocabulary to a fixed direction property.
// The property names never change; only the words are German. Each umlaut word
// (sueden, suedosten, suedwesten) carries its ASCII form for typing.
direction north     "norden", "nord", "n"
direction south     "süden", "süd", "s"
direction east      "osten", "ost", "o"
direction west      "westen", "west", "w"
direction northeast "nordosten", "nordost", "no"
direction northwest "nordwesten", "nordwest", "nw"
direction southeast "südosten", "südost", "so"
direction southwest "südwesten", "südwest", "sw"
// Up and down need many German forms: hoch, rauf, hinauf, aufwaerts,
// oben (for "nach oben"), and likewise runter, hinunter, hinab, abwaerts,
// unten. A bare "auf" is missing on purpose: it is the unlock particle
// ("schliess die Tuer auf"), and a dictionary word carries one role only.
// A bare "ab" would not be German anyway.
direction up        "hoch", "rauf", "hinauf", "aufwärts", "oben", "h"
direction down      "runter", "hinunter", "hinab", "abwärts", "unten", "r"
direction in        "rein", "hinein"
direction out       "hinaus", "heraus"

// HEB DIE LAMPE AUF: aufheben is the German pick up; the particle (auf)
// runs empty and falls through to plain take, which is exactly right.
verb "nimm", "nehmen", "nimmt", "hol", "hole", "schnapp", "heb", "hebe"
    take noun

// LASS DIE LAMPE FALLEN: the canonical German DROP. "lass" carries the
// action, and the trailing "fallen" is declared a noise word (the phrase
// scoring simply does not count it); "wirf" belongs to WERFEN, throwing,
// and waits for a German throw family.
verb "lass", "lasse", "fallenlassen", "wegwerfen", "weglegen"
    drop noun

noise "fallen"

verb "untersuch", "untersuche", "untersuchen", "betrachte", "prüfe", "x"
    examine noun
    look_under noun

// Meta verbs. Each sets meta_turn, so the loop skips the per-turn pulse and the
// turn count. quit and restart confirm first. Every meta verb ALSO answers
// to its English original (quit, score, save, restore, undo, again, oops,
// transcript): a player raised on English adventures will not always guess
// the German word first try, and the session verbs simply have to work.
verb "beende", "beenden", "ende", "quit"
    quit

verb "punkte", "punktzahl", "score"
    score

verb "neustart", "neustarten", "restart"
    restart

// Saving and restoring.
verb "sichern", "sichere", "speichern", "speichere", "save"
    save

verb "laden", "lade", "wiederherstellen", "restore", "load"
    restore

// The transcript (output stream 2): MITSCHRIFT or PROTOKOLL starts it,
// MITSCHRIFT AUS ends it. The an/aus particles run through compound just
// as with schalt; the file belongs to the interpreter. English fallback:
// TRANSCRIPT ON/OFF (the particles below know on and off) and UNSCRIPT.
verb "mitschrift", "protokoll", "transkript", "transcript", "script"
    transcript
    transcript_off

verb "unscript"
    transcript_off

// undo and again are intercepted by the turn loop before dispatch.
verb "widerrufen", "rückgängig", "undo"
    undo

verb "wiederhole", "wiederholen", "nochmal", "g", "again"
    again

verb "ups", "hoppla", "korrigiere", "oops"
    oops

// The magic word, a normal (if fruitless) action; an author can override it.
verb "xyzzy"
    xyzzy

verb "inventar", "i", "inv"
    inventory

verb "version" meta
    version

verb "notify", "punktemeldung" meta
    notify

// Typed answers: a game that asks a question reads them with `on yes` /
// `on no`.
verb "ja", "jawohl"
    yes

verb "nein"
    no

// Switching on and off. The base verb "schalt(e)" takes a particle after
// or before the noun: "schalt die Lampe an", "schalt die Lampe ein", and
// (grammatically crooked but usual in text adventures) "schalt an Lampe".
// The fused forms cover "einschalten Lampe" as well.
// ZUENDE DIE KERZE AN, ENTZUENDE DIE FACKEL: anzuenden is the German
// "light"; the particle (an) turns it into switch_on, as with schalte ... an.
verb "schalt", "schalte", "zünde", "entzünde"
    switch_on noun
    switch_off noun

verb "einschalten", "anschalten", "anmachen"
    switch_on noun

verb "ausschalten", "abschalten", "ausmachen"
    switch_off noun

// The switch particles. "an"/"ein" switch on, "aus"/"ab" switch off. "an"
// also serves as a preposition (gib X an Y); no harm done, since the parser
// treats any flagged word as a phrase boundary and compound only acts on
// switch/turn/take.
particle on  "an", "ein", "on"
particle off "aus", "ab", "off"

verb "anziehen", "anlegen", "trag", "trage"
    wear noun

verb "ausziehen", "ablegen", "abnehmen"
    take_off noun

verb "leg", "lege", "stell", "stelle", "setz", "setze"
    put noun auf noun
    put noun in noun

// SETZ DICH AUF DIE BANK arrives through the put family (setz and setze
// are stellen/legen words), and putting YOURSELF somewhere is perfectly
// ordinary German for sitting down, so the pack forwards it to enter:
// the seat's own on enter fires and the enter contract applies. LEG
// DICH AUF and STELL DICH AUF ride the same road. This is the pack's
// rule, not the library's: the English phrasing ("put yourself on the
// bench") is not idiomatic and stays with put (Stefan's ruling,
// 2026-08-24). An object's own on put still outranks this, as always.
//
// The POSTURE travels along (Stefan, same day: sitting and being on
// top of something are not the same; core-wide for every language since
// 2026-08-25, see board_report in actions.prelude). German captures it
// HERE, in the reflexive put redirect, before perform clears
// verb_trigger (an enter nobody typed has no typed word); posture_note
// below then preserves the pending value through the hop.

on put
    if noun is player
        if second is not nothing
            change posture to 8
            if verb_trigger is "setz"
                change posture to 9
            if verb_trigger is "setze"
                change posture to 9
            if verb_trigger is "leg"
                change posture to 10
            if verb_trigger is "lege"
                change posture to 10
            if verb_trigger is "stell"
                change posture to 11
            if verb_trigger is "stelle"
                change posture to 11
            perform("enter", second)
            stop
    continue

verb "steck", "stecke", "einstecken"
    insert noun in noun

verb "öffne", "öffnen"
    open noun mit noun
    open noun

// Closing, locking, and unlocking as one separable base verb. A bare
// "schliess(e)" closes. With a particle it becomes the natural separable
// form: "schliess die Tuer ab" or "... zu" locks (with or without "mit dem
// Schluessel"), "... auf" unlocks. The particle may come before or after
// the noun; that is exactly how a German says it: "Hast du die Haustuer
// abgeschlossen?" -> "schliess die Haustuer ab". The mit-line carries the
// key into the second slot ("schliess die Tuer mit dem Schluessel ab");
// WHICH action runs is decided by the particle alone (compound above),
// never by the line, which is why every line here says close.
verb "schließe", "schließ", "schließen", "zumachen"
    close noun
    close noun mit noun

// The lock particles. "auf" unlocks; "zu" and "ab" lock. "ab" doubles as
// the switch-off particle; compound tells them apart by the base verb
// (schalt vs. schliess), so the double role does no harm.
// The player object: the self words every game answers to ("untersuche
// dich"), a printable name, and the named flag to suppress the article.
// A game adds its own words with player.words.
player.words mich, dich, selbst
player.name "dich selbst"
player.named

// The chain words (docs/01 chapter 14): each one ends a command and
// starts the next on the same line ("nimm die lampe und oeffne die tuer,
// dann geh nach norden"). The comma counts as a word of its own, with or
// without a space.
chain ",", "und", "dann"

// The noise words: the articles the parser knows but reads past. Being
// KNOWN is the point: a noun list may carry them ("nimm die lampe und den
// schluessel"), while a genuinely unknown word honestly refuses the
// borrowed verb (docs/01 chapter 14).
noise "der", "die", "das", "den", "dem", "des", "ein", "eine", "einen", "einem", "einer"

// The mention stamps for the pronoun slots, and their shared counter.
// Only this pack (multi-role words) reads or writes them, so they live
// here and no other language pays for them.
global pron_seq = 0
global pron_at_it = 0
global pron_at_him = 0
global pron_at_her = 0
global pron_at_them = 0

// The pronouns as German really distributes them (the forum's depth
// round): "ihn" and "es" are unambiguous, but "ihm" is the dative of
// masculine AND neuter ("rede mit ihm" about das Kind), "sie" is feminine
// AND plural, "ihr" only the feminine dative, "ihnen" only the dative
// plural. A word with two slots takes the most recently mentioned live
// referent, silently (the round's ruling: pronouns follow recency, no
// asking).
pronoun it  "es"
pronoun him "ihn"
pronoun him, it "ihm"
pronoun her "ihr"
pronoun her, them "sie"
pronoun them "ihnen"

// The pronominal adverbs (docs/01 chapter 14): German fuses preposition and
// referent into one word, damit for "mit ihm/ihr/es", darauf for "auf ...",
// with the colloquial short forms. The word is genderless and never names a
// person; the resolver binds the freshest non-animate referent into the
// second slot and splices the word out of the parse buffer, so scoring, the
// split, and every fault range see a clean command ("oeffne die truhe
// damit", "leg das buch darauf", position-free like the German). darunter
// and drunter stay particles (they pick look_under) and bind the same
// referent when the noun slot comes up empty.
pronoun da "damit", "darauf", "drauf", "darin", "drin", "daran", "dran"

// The German ending strip (docs/01 chapter 21): a typed word the dictionary
// does not know sheds an adjective ending, en/er/es/em first, then a bare
// e, and is accepted ONLY when the stem is some object's >-marked adjective
// (dictionary flat, one stem declared, every case form types: rot carries
// roten, rotem, rote). Nouns never strip, so declaration work stays
// declaration work, and a stripped word that still resolves nothing keeps
// the honest unknown-word report under its typed spelling. The candidate
// stem is looked up through the interpreter's own tokenizer over a scratch
// corner of the ask buffer, which is idle whenever parsing runs.
block strip_endings()
    let n = word_count
    let i = 1
    while i < n
        if word_dict(i) is nothing
            try_strip(i)
        change i to i + 1
    return 0

block try_strip(i)
    let len = word_len(i)
    if len < 4
        return 0
    let p = word_pos(i) - 2
    let cut = 0
    // ZSCII: e 101, n 110, r 114, s 115, m 109
    if text_char(p + len - 1) is 101
        change cut to len - 1
    if text_char(p + len - 2) is 101
        let last = text_char(p + len - 1)
        if last is 110
            change cut to len - 2
        if last is 114
            change cut to len - 2
        if last is 115
            change cut to len - 2
        if last is 109
            change cut to len - 2

    if cut < 3
        return 0
    // The scratch: a one-word text buffer at ask_addr, a one-entry parse
    // buffer at ask_addr + 20; both dead outside this lookup.
    let j = 0
    while j < cut
        poke_byte(ask_addr + 2 + j, text_char(p + j))
        change j to j + 1
    poke_byte(ask_addr, 15)
    poke_byte(ask_addr + 1, cut)
    poke_byte(ask_addr + 20, 1)
    poke_byte(ask_addr + 21, 0)
    tokenise_at(ask_addr, ask_addr + 20)
    let d2 = peek_word(ask_addr + 22, 0)
    if d2 is nothing
        return 0
    // The stem must be somebody's marked adjective: the scope guarantee.
    let obj = 1
    let hit = 0
    while obj <= object_count
        if has_adjective(obj, d2) is 1
            change hit to 1
            change obj to object_count
        change obj to obj + 1
    if hit is 0
        return 0
    poke_word(parse_addr, 1 + 2 * i, d2)
    return 1

// The freshest remembered THING, for a da-word: the most recently mentioned
// referent across all four slots, skipping the animate (German "damit"
// never means a person; right after talking to the innkeeper it still
// reaches the key) and skipping excl, the object being acted on: "leg das
// buch darauf" must never put the book on itself, however fresh its
// mention. Nothing when nothing qualifies: the honest refusal.
block da_referent(excl)
    let best = nothing
    let bat = 0
    if pron_it is not nothing
        if pron_it is not animate
            if pron_it is not excl
                if pron_at_it > bat
                    change best to pron_it
                    change bat to pron_at_it
    if pron_him is not nothing
        if pron_him is not animate
            if pron_him is not excl
                if pron_at_him > bat
                    change best to pron_him
                    change bat to pron_at_him
    if pron_her is not nothing
        if pron_her is not animate
            if pron_her is not excl
                if pron_at_her > bat
                    change best to pron_her
                    change bat to pron_at_her
    if pron_them is not nothing
        if pron_them is not animate
            if pron_them is not excl
                if pron_at_them > bat
                    change best to pron_them
                    change bat to pron_at_them
    return best

// Find a typed da-word (pronoun flag, role 7), bind the second slot, and
// SPLICE the word out of the parse buffer (2-byte header, then 4 bytes per
// word), so everything downstream reads a clean command. Returns 1 when a
// da-word claimed the slot (parse_fault 5 speaks for an empty referent),
// 0 when none was typed.
block bind_daword()
    let n = word_count
    let i = 1
    while i < n
        let d = word_dict(i)
        if d is not nothing
            if peek_byte(d + 6) is 4
                if peek_byte(d + 7) is 7
                    change second to da_referent(nothing)
                    if second is nothing
                        change parse_fault to 5
                        return 1
                    copy_bytes(parse_addr + 6 + 4 * i, parse_addr + 2 + 4 * i, 4 * (n - 1 - i))
                    poke_byte(parse_addr + 1, n - 1)
                    return 1
        change i to i + 1
    return 0

// Was an under-particle typed ("schau darunter", and the plain "unter" of a
// hurried player reads the same way)? For the empty-noun binding below.
block find_under_particle()
    let n = word_count
    let i = 1
    while i < n
        let d = word_dict(i)
        if d is not nothing
            if peek_byte(d + 6) is 32
                if peek_byte(d + 7) is 5
                    return 1
        change i to i + 1
    return 0

// The pick for a multi-role word (the skeleton's seam): role 5 is "ihm"
// (masculine OR neuter), role 6 is "sie" (feminine OR plural). The most
// recently mentioned live referent wins, silently; whether it is still in
// scope is judged afterwards by the caller, so the honest refusal speaks
// rather than an older referent quietly stepping in.
block pronoun_pick(role)
    if role is 5
        return fresher(pron_him, pron_at_him, pron_it, pron_at_it)
    if role is 6
        return fresher(pron_her, pron_at_her, pron_them, pron_at_them)
    return nothing

// The fresher of two remembered referents, by stamp; an empty slot is no
// candidate at all.
block fresher(a, a_at, b, b_at)
    if a is nothing
        return b
    if b is nothing
        return a
    if a_at > b_at
        return a
    return b

// Which slot a resolved noun fills: pluribus things go to the plural slot
// first, everything else by the gender the author declared with
// der/die/das. Every filing stamps its slot (pron_seq) so a multi-role
// word ("ihm", "sie") finds the freshest mention. The skeleton calls this
// after every command. (The counter wraps at 16 bits; after 65535 mentions
// ONE comparison orders wrongly once, then the world is right again.
// Cheaper than any precaution.)
block note_pronouns(obj)
    change pron_seq to pron_seq + 1
    if any_pluribus is 1
        if obj is pluribus
            change pron_them to obj
            change pron_at_them to pron_seq
            return 0
    if obj is feminine
        change pron_her to obj
        change pron_at_her to pron_seq
        return 0
    if obj is neutral
        change pron_it to obj
        change pron_at_it to pron_seq
        return 0
    change pron_him to obj
    change pron_at_him to pron_seq

particle auf "auf"
particle zu  "zu"
particle under "unter", "unters", "darunter"

// Locking and unlocking also as their own INSEPARABLE verbs ("entriegele
// die Tuer mit dem Schluessel"), with the fused ab-/aufsperren as
// synonyms, for players who prefer typing a single verb.
verb "verriegele", "verriegle", "verriegeln", "absperren", "zusperren"
    lock noun mit noun
    lock noun

verb "entriegele", "entriegle", "entriegeln", "aufsperren"
    unlock noun mit noun
    unlock noun

verb "betrete", "betreten", "besteige", "besteigen"
    enter noun

verb "aussteigen", "raussteigen", "heraussteigen", "verlasse", "verlassen"
    exit
    exit noun

verb "gib", "gebe", "geben", "reich", "reiche"
    give noun an noun
    give noun noun reverse

verb "zeig", "zeige", "zeigen"
    show noun an noun
    show noun noun reverse

verb "berühre", "berühren", "fühl"
    touch noun

verb "riech", "rieche", "riechen", "schnupper"
    smell
    smell noun

verb "schmeck", "schmecke", "koste", "probier", "probiere"
    taste noun

verb "hör", "höre", "lausche", "horch"
    listen
    listen noun

verb "iss", "essen", "esse"
    eat noun

verb "trink", "trinke", "trinken", "schluck"
    drink
    drink noun

verb "schlag", "schlage", "angreifen", "hau", "tritt", "zerstöre", "brich"
    attack noun

verb "küss", "küsse", "umarme"
    kiss noun

verb "drück", "drücke", "schieb", "schiebe", "press"
    push noun

verb "zieh", "ziehe", "ziehen", "zerr"
    pull noun

verb "dreh", "drehe", "drehen", "rotiere"
    turn noun

verb "kletter", "klettere", "klettern", "erklimme"
    climb noun

verb "lies", "lesen", "liest"
    examine noun

verb "sprich", "rede", "reden", "sprechen"
    talk noun

verb "frag", "frage", "befrage"
    ask noun
    ask noun nach
    ask noun über
    ask noun ueber

verb "erzähl", "erzähle", "sag", "sage"
    tell noun
    tell noun von
    tell noun über
    tell noun ueber

verb "antworte", "antworten"
    answer noun

verb "spring", "springe", "hüpf", "hüpfe"
    jump

verb "warte", "warten", "z"
    wait

verb "sing", "singe", "singen"
    sing

// ==========================================================================
// 3. THE MESSAGES
// Every line shown to the player, and the room and content listing.
// ==========================================================================

// Articles. The compiler lowers ${the noun} / ${a noun} to a call to one of these
// with the object, a capitalize flag (1 for ${The} / ${A}), and, when the message
// tags one, a grammatical case (${the:acc noun}). With no tag, the case argument
// is not passed at all, so `kase` keeps its default of 0 (nominative).
//
// Gender comes from the object: `neutral` (das), `feminine` (die), or neither
// (der, masculine). Case is `kase`: 0 nominative, 1 accusative, 2 dative, 3
// genitive. Every definite article starts with d, every indefinite with e, so the
// capital is printed once and the case/gender tail follows: der/die/das, den, dem,
// des; ein/eine, einen, einem, eines. A `named` object (Linda, Excalibur) takes no
// article; that check folds away in a game with no named objects (any_named).
block art_the(obj, cap, kase)
    // Total, like the containment test: an unresolved noun prints
    // as the word, never an illegal print_obj 0 (docs/01 chapter 15).
    if obj is nothing
        show("nichts")
        return

    if any_named is 1
        if obj is named
            print_name(obj)
            return
    // A hand-set article wins over derivation (docs/01 chapter 15): las
    // tijeras, el agua. Printed as stored, so keep it lowercase and let such
    // objects sit mid-sentence.
    if article_addr(obj) is not 0
        show("${obj.article}")
        show(" ")
        print_name(obj)
        return
    // The plural (pluribus): die/die/den/der, its own column of the case
    // table. Folds away without marked objects.
    if any_pluribus is 1
        if obj is pluribus
            if cap is 1
                show("D")
            else
                show("d")
            if kase is 2
                show("en ")
            else
                if kase is 3
                    show("er ")
                else
                    show("ie ")
            print_name(obj)
            return
    if cap is 1
        show("D")
    else
        show("d")
    if obj is neutral
        if kase is 2
            show("em ")
        else
            if kase is 3
                show("es ")
            else
                show("as ")
    else
        if obj is feminine
            if kase is 2
                show("er ")
            else
                if kase is 3
                    show("er ")
                else
                    show("ie ")
        else
            if kase is 0
                show("er ")
            else
                if kase is 1
                    show("en ")
                else
                    if kase is 2
                        show("em ")
                    else
                        show("es ")
    print_name(obj)

block art_a(obj, cap, kase)
    // Total, like the containment test: an unresolved noun prints
    // as the word, never an illegal print_obj 0 (docs/01 chapter 15).
    if obj is nothing
        show("nichts")
        return

    if any_named is 1
        if obj is named
            print_name(obj)
            return
    // A hand-set indefinite wins over derivation: unas tijeras, some water.
    if indefinite_addr(obj) is not 0
        show("${obj.indefinite}")
        show(" ")
        print_name(obj)
        return
    // An indefinite plural takes no article in German: "Du siehst hier
    // Stiefel." Folds away without marked objects.
    if any_pluribus is 1
        if obj is pluribus
            print_name(obj)
            return
    if cap is 1
        show("E")
    else
        show("e")
    if obj is neutral
        if kase is 2
            show("inem ")
        else
            if kase is 3
                show("ines ")
            else
                show("in ")
    else
        if obj is feminine
            if kase is 2
                show("iner ")
            else
                if kase is 3
                    show("iner ")
                else
                    show("ine ")
        else
            if kase is 0
                show("in ")
            else
                if kase is 1
                    show("inen ")
                else
                    if kase is 2
                        show("inem ")
                    else
                        show("ines ")
    print_name(obj)

// The copula with number (docs/01 chapter 15): ${is x} prints "ist" or
// "sind" by the object's pluribus attribute. The plural branch folds away
// without marked objects.
block art_is(obj, cap)
    if any_pluribus is 1
        if obj is pluribus
            if cap is 1
                show("Sind")
            else
                show("sind")
            return 0
    if cap is 1
        show("Ist")
    else
        show("ist")
    return 0

// The banner words. The compiler assembles the banner (title, headline,
// author, version line), but the words BETWEEN the parts belong to the
// language: line_by prints the connective between headline and author,
// banner_headline the default headline when the game sets none.
block line_by()
    show(" von ")

// The nested-location suffix in the title line and the status bar:
// "Krypta (auf dem Altar)", "Keller (in der Kiste)". Supporters take
// "auf", everything else "in"; the article comes from art_the in the
// dative (kase 2).
block line_nested(obj)
    if obj is supporter
        show(" (auf ")
    else
        show(" (in ")
    art_the(obj, 0, 2)
    show(")")

// The status bar's left side in the dark: the room name would give away
// what cannot be seen, so the bar names the darkness itself.
block line_dark_status()
    show("Im Dunkeln")

block banner_headline()
    show("Ein Textadventure")

// The input prompt. It requests a paragraph break rather than forcing its own.
block prompt()
    // The blank line before the prompt belongs to the turn's TEXT: a turn
    // that printed nothing (a consuming handler with no say, the field
    // report) goes straight to the next prompt, no stray gap. par_flush
    // raises `spoke` on any print; the prompt consumes it.
    if spoke is 1
        par
    else
        change par_pending to 0
    show(">")
    change spoke to 0

// What of a holder's contents should be listed: not hidden or concealed, and
// either the holder shows its contents or the player already knows the item is
// there (the knowledge model).
block content_listable(holder, x)
    // The player never lists as a holder's contents ("an altar (contains
    // yourself)"); possible only where something is enterable, so it folds.
    if any_enterable is 1
        if x is player
            return 0
    // A component is part of the holder, not carried contents: the machine
    // never lists its own levers. Folds away without components.
    if any_components is 1
        if x is component
            return 0
    if x is hidden
        return 0
    if x is concealed
        return 0
    if see_into(holder)
        return 1
    if x is seen
        return 1
    return 0

// One scenery holder's paragraph (constant scenery_contents = 1): what
// sits on or in it, the knowledge model deciding per item. Prints
// nothing when the holder holds nothing tellable.
// How many of a holder's contents the listing would name.
block listable_count(holder)
    let total = 0
    for each x in holder
        if content_listable(holder, x)
            change total to total + 1
    return total

block scenery_holder_line(obj)
    if obj is not container
        if obj is not supporter
            return 0
    if listable_count(obj) is 0
        return 0
    par
    if obj is supporter
        show("Auf ")
    else
        show("In ")
    art_the(obj, 0, 2)
    // "siehst du" governs the accusative, like every enumeration here:
    // the shared loop (name_contents) speaks it throughout.
    show(" siehst du ")
    name_contents(obj)
    say "."

// The bare list itself, the composable primitive: the visible contents
// with article, commas, and one "und", each marked seen; the count comes
// back (0 prints nothing at all). Accusative, because every sentence that
// names things here governs it; a special case brings its own loop with
// ${a:dat x}. One level deep.
// The list's case follows the governing verb: enthaelt and "Darin
// findest du" take the accusative (the default), darauf liegt/liegen
// the nominative. The caller sets list_fall; name_contents reads and
// keeps it (several callers share one listing).
global list_fall = 0

block name_contents(holder)
    let total = listable_count(holder)
    if total is 0
        return 0
    let shown = 0
    for each x in holder
        if content_listable(holder, x)
            if shown is not 0
                if shown is total - 1
                    show(" und ")
                else
                    show(", ")
            if list_fall is 1
                show("${a x}")
            else
                show("${a:acc x}")
            now x is seen
            change shown to shown + 1
    return total

// Append " (enthaelt ...)" to a container or supporter just named. "enthaelt"
// takes the accusative, so the contents are listed with ${a:acc x}.
block list_contents(holder)
    if holder is supporter
        list_contents_run(holder)
        return 0
    if holder is container
        list_contents_run(holder)
    return 0

block list_contents_run(holder)
    if listable_count(holder) is 0
        return 0
    // A supporter is not a container (Stefan's ruling, 2026-08-25):
    // enthaelt belongs to containers; what rests on top lies there, in
    // the nominative (list_fall).
    if holder is supporter
        if listable_count(holder) is 1
            show(" (darauf liegt ")
        else
            show(" (darauf liegen ")
        change list_fall to 1
    else
        show(" (enthält ")
    name_contents(holder)
    change list_fall to 0
    show(")")
    return 0

// After a container is opened, name what is revealed inside (marking it seen).
// "Darin findest du" governs the accusative.
block reveal_contents(holder)
    if listable_count(holder) is 0
        return 0
    show("Darin findest du ")
    name_contents(holder)
    say "."

// One thing as the room listing names it: article (accusative), the
// closed qualifier, its tag, its contents in passing. The single line and
// the combined sentence both speak through this.
block name_room_item(obj)
    show("${a:acc obj}")
    // An openable thing that is shut says so (Pablo Martinez' suggestion,
    // the PunyInform qualifier): the one state the listing would not
    // otherwise reveal. The predicative does not inflect, so ONE word
    // serves.
    if obj is openable
        if obj is not open
            show(" (geschlossen)")
    show_tag(obj)
    list_contents(obj)

// One line of a room's contents listing. "Du siehst hier" governs the accusative.
block list_item(obj)
    show("Du siehst hier ")
    name_room_item(obj)
    say "."

// The room listing's combined sentence (Cosmos 1.5.0): every plain thing
// in ONE sentence, "Du siehst hier eine Laterne, eine Notration und einen
// Rucksack.", instead of a line per thing. What counts as plain is
// room_plain's call, the same preselection that counted. A single thing
// still goes through list_item, so a game that overrode list_item keeps
// its wording.
block list_room(total)
    if total is 1
        for each x in here
            if room_plain(x) is 1
                list_item(x)
        if any_presence is 1
            list_presence_one
        return 0
    show("Du siehst hier ")
    let shown = 0
    for each x in here
        if room_plain(x) is 1
            if shown is not 0
                if shown is total - 1
                    show(" und ")
                else
                    show(", ")
            name_room_item(x)
            change shown to shown + 1
    if any_presence is 1
        list_presence_tail(shown, total)
    say "."

// The existence objects' tail of the combined sentence (docs/01 chapter
// 3): objects standing here beyond the tree join after the room's own
// children, with the same separators. Folds away without the form.
block list_presence_tail(shown, total)
    let p = presence_next(0)
    while p is not nothing
        if shown is not 0
            if shown is total - 1
                show(" und ")
            else
                show(", ")
        name_room_item(p)
        change shown to shown + 1
        change p to presence_next(p)
    return 0

// Parser.
// The player typed a word the story's dictionary does not know at
// all: name it (spelled back from the text buffer), so a typo is
// told apart from a real thing that is not here.
block msg_unknown_word()
    show("Das Wort \"")
    let p = word_pos(unknown_at) - 2
    let n = word_len(unknown_at)
    let i = 0
    while i < n
        show_char(text_char(p + i))
        change i to i + 1
    say "\" kennt diese Geschichte nicht."

// An incomplete command (a bare NIMM, a LEG with no where): the one
// honest ask. It never guesses the missing role ("Tanz was?" would guess
// wrong when the grammar wanted WITH WHOM); it only says the command
// needs more. The verb is spelled back AS TYPED from the text buffer
// (full length, the dictionary limit stays invisible), and lowercase
// fits mid-sentence.
block msg_noun_missing()
    show("Das Verb ")
    let p = word_pos(0) - 2
    let n = word_len(0)
    let i = 0
    while i < n
        show_char(text_char(p + i))
        change i to i + 1
    say " verlangt eine genauere Angabe."

// The beyond refusal (docs/01): visible, but the hand cannot reach.
block msg_beyond(obj)
    if any_pluribus is 1
        say "${The obj} ${is obj} außer Reichweite."
        return 0
    say "${The obj} ist außer Reichweite."

block msg_cant_see()
    say "So etwas siehst du hier nicht."

block msg_press_any_key()
    say "[...]"

block msg_open_first()
    say "Dazu musst du erst ${the:acc shut_in} öffnen."

block msg_no_it()
    say "Du musst schon genau sagen, was gemeint ist."

block msg_be_specific()
    say "Du musst dich schon etwas genauer ausdrücken."

// The disambiguation ask (docs/01 chapter 14): the framing around the
// parser's candidate list ("Was meinst du: die goldene Muenze oder den
// Schluessel?"). "meinen" governs the accusative, hence ${the:acc obj}.
block line_which_open()
    show("Was meinst du: ")

block line_which_or()
    show(" oder ")

block line_which_item(obj)
    show("${the:acc obj}")

block line_which_end()
    say "?"

block msg_nothing_again()
    say "Es gibt nichts zu wiederholen."

block msg_only_animate()
    say "Wenn du weiter mit Gegenständen redest, wird wohl die nächste Sitzung beim Therapeuten fällig."

// Conversation lines. The speaker label, the separator, and the quotation marks
// live here. line_reply receives the speaking person; ${The x} prints a named
// person bare (Linda) and others with the article (der Wächter).
block line_you()
    show("Du: \"")

block line_reply(speaker)
    show("${The speaker}: \"")

block line_end()
    say "\""

// Conversation menu framing (the conversations granule). "sprich mit" governs the
// dative; "über" heads the topic list.
block line_talk_header(who)
    show("Sprich mit ${the:dat who} über:")

block line_talk_prompt()
    show("Wähle ein Thema oder beende mit 0.")

block msg_no_topics()
    say "Dir fällt gerade nichts Sinnvolles ein."

block msg_talk_over()
    say "Du beendest das Gespräch."

// The status line's score side (the statusline granule): score and moves,
// right-aligned, in German words and widths. "Punkte: " is eight cells like the
// English "Score: " string it replaces; the wide form adds "   Zuege: ".
block line_status_score(w)
    if any_awards is 0
        set_cursor(1, w - 8 - status_digits(turns))
        show(" Züge: ")
        show(turns)
        return 0
    if w < 54
        set_cursor(1, w - 10 - status_digits(score) - status_digits(turns))
        show(" Punkte: ")
        show(score)
        show("/")
        show(turns)
    else
        set_cursor(1, w - 18 - status_digits(score) - status_digits(turns))
        show(" Punkte: ")
        show(score)
        show("   Züge: ")
        show(turns)

// Room and light.
block msg_dark_room()
    say "Völlige Dunkelheit. Nicht einmal deine Hände kannst du sehen."

block msg_too_dark()
    say "Es ist zu dunkel, um etwas zu erkennen."

// Movement.
block msg_cant_go()
    say "Es gibt keinen Ausgang in diese Richtung."

block msg_no_direction()
    say "In welche Richtung?"

block msg_cant_enter()
    say "In ${the:acc noun} kommst du nicht hinein."

block msg_already_there()
    say "Du bist schon hier."

block msg_not_inside()
    say "Du bist in nichts, aus dem du aussteigen könntest."

// Auf-/Einsteigen und Ab-/Aussteigen (board_report / leave_report). auf/in mit
// Bewegung fordern den Akkusativ, von/aus den Dativ. (Zur Durchsicht: Stefan.)
//
// The report conjugates the player's own verb back: sitting and being on
// top of something are not the same (Stefan, 2026-08-24, the bench edge
// case). SETZ DICH answers "Du setzt dich...", LEG DICH "Du legst
// dich...", STELL DICH "Du stellst dich...", and only the climbing and
// entering words keep "Du steigst...". verb_trigger is the word as
// typed, so the same setz that puts a cup on a table still reports the
// put; only the reflexive road through enter lands here.
// The language layer's posture seam (core enter calls it): the redirect
// already noted the pending value, keep it; any direct boarding
// (betrete, besteige) is a climb, whatever an earlier seat left behind.
block posture_note()
    if posture >= 8
        return 0
    change posture to 8
    return 0

block msg_get_on()
    if posture is 1
        say "Du setzt dich auf ${the:acc noun}."
        return 0
    if posture is 2
        say "Du legst dich auf ${the:acc noun}."
        return 0
    if posture is 3
        say "Du stellst dich auf ${the:acc noun}."
        return 0
    say "Du steigst auf ${the:acc noun}."

block msg_get_in()
    if posture is 1
        say "Du setzt dich in ${the:acc noun}."
        return 0
    if posture is 2
        say "Du legst dich in ${the:acc noun}."
        return 0
    say "Du steigst in ${the:acc noun}."

// Leaving speaks the posture too (Stefan, 2026-08-25): whoever sat or
// lay STANDS UP; only whoever stood or climbed climbs down.
block msg_get_off()
    if posture is 1
        say "Du stehst von ${the:dat noun} auf."
        return 0
    if posture is 2
        say "Du stehst von ${the:dat noun} auf."
        return 0
    say "Du steigst von ${the:dat noun} herunter."

block msg_get_out()
    say "Du steigst aus ${the:dat noun}."

block msg_cant_climb()
    if any_pluribus is 1
        say "${The noun} ${is noun} nicht zum Klettern geeignet."
        return 0
    say "${The noun} ist nicht zum Klettern geeignet."

