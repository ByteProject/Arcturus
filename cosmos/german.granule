// One line of an inventory listing; a worn item is tagged, a container or
// supporter names what it holds. A bare list reads as nominative.
block list_held(obj)
    show("  ")
    show("${a obj}")
    if obj is worn
        show(" (getragen)")
    show_tag(obj)
    list_contents(obj)
    say ""

// Take all (summon.takeall, docs/01 chapter 22): every line here
// vanishes in a game without the granule.
block msg_all_none()
    say "Hier gibt es nichts, das sich mitzunehmen lohnt."

block msg_all_none_in(source)
    say "In ${the:dat source} gibt es nichts, das sich mitzunehmen lohnt."

block msg_all_verb()
    say "Eins nach dem anderen."

// Pathfinding (summon.pathfinding, docs/01 chapter 22): every line here
// vanishes in a game without the granule. The direction frames echo the
// typed word ("In Richtung Norden liegt die Halle."), so the compass and
// any future nautical set share one sentence.
block line_stride()
    say "(durch ${the:acc here})"

block line_seek_notice(r)
    say "(du machst dich auf den Weg zu ${the:dat r})"


block msg_no_way_known()
    say "Du kennst keinen Weg dorthin."

block msg_unknown_place()
    say "Diesen Ort kennst du nicht."

block msg_seek_unknown()
    say "Davon weißt du nichts."

block msg_find_here(o)
    say "${The o} ist doch genau hier."

block msg_seek_near(o)
    say "${The o} müsste hier irgendwo sein."

block msg_nothing_that_way()
    say "Dort liegt nichts."

block msg_door_shut_way(d)
    let at = dir_word_at
    if at is 0
        say "${The d} versperrt dort den Weg."
        return 0
    show("${The d} versperrt den Weg in Richtung ")
    show_dir_word(at, 1)
    say "."

block msg_way_lies(d)
    let at = dir_word_at
    if at is 0
        say "Dort liegt ${the d}."
        return 0
    show("In Richtung ")
    show_dir_word(at, 1)
    say " liegt ${the d}."

block msg_way_unknown()
    let at = dir_word_at
    if at is 0
        say "Der Weg dort ist offen, aber du bist ihn noch nie gegangen."
        return 0
    show("Der Weg in Richtung ")
    show_dir_word(at, 1)
    say " ist offen, aber du bist ihn noch nie gegangen."
