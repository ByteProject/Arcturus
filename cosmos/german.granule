block line_foresight_exit(seat)
    if seat is supporter
        if posture is 1
            say "(zuerst stehst du von ${the:dat seat} auf)"
            return 0
        if posture is 2
            say "(zuerst stehst du von ${the:dat seat} auf)"
            return 0
        say "(zuerst steigst du von ${the:dat seat} herunter)"
    else
        say "(zuerst steigst du aus ${the:dat seat})"

