// debug.granule
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// summon.debug: developer testing verbs. There is no separate release build to
// strip them from; summoning the granule is the opt-in, and leaving it unsummoned
// leaves them out entirely. The primaries are Arcturus-named, with the familiar
// Inform synonyms (purloin, gonear, showobj) alongside.
//
// fetch, warp, and inspect reach ANY object, in scope or not - that is the whole
// point of a debug verb. They get there through the reach_unscoped parser seam:
// when ordinary scope matching fails, the parser asks this granule to try, and it
// matches the typed word against every object in the game rather than aborting.
//
// Looking for Inform's RECORDING / REPLAY to step through a walkthrough? That is
// not a verb here: it lives in the interpreter, so it costs the story nothing.
// Actaea records, replays, and checks a session with `actaea --record`,
// `--replay`, and `--check` (docs/06 section 3).

// The parser's rebind (the debug_rebind stub, called from parse_line once
// the nouns have resolved). For a debug verb only, the typed words are
// matched against every object in the game and the best replaces whatever
// the scope match found: the scope match alone would bind a partial match
// in hand before the far one was ever looked for. Other verbs fall through
// and still answer "you can't see that".
block debug_rebind(act)
    if act is action_id("fetch")
        rebind_any(0)
    if act is action_id("warp")
        rebind_any(1)
    if act is action_id("inspect")
        rebind_any(0)

block rebind_any(rooms_first)
    let far = match_any(rooms_first)
    if far is not nothing
        change noun to far
        change parse_fault to 0
        if any_reach is 1
            change reached to 1

// The object the typed words (after the verb) name best: every object in
// the game, hidden ones included, scored by how many of the typed words
// its vocabulary carries, the way the real matcher scores scope. The best
// count wins; an exact tie (two balls of wool, PURLOIN WOOL) goes to the
// one declared first, so a distinguishing word settles it (PURLOIN WHITE
// WOOL). Before this, the first typed word that named anything took the
// first object carrying it, so PURLOIN BLACK WOOL fetched the black blob
// (EdwardianDuck's report, 2026-10-08). With rooms_first (GONEAR), a
// room wins a tie: GONEAR GARDEN means the Garden, not a garden gnome
// standing somewhere (auraes's report, 2026-10-25). Room names are
// vocabulary while this granule is summoned (the compiler's
// room_names_are_words), so a room is reachable by its name at all.
block match_any(rooms_first)
    let best = nothing
    let best_n = 0
    let obj = 1
    while obj <= object_count
        let n = 0
        let i = 1
        while i < word_count
            let d = word_dict(i)
            if d is not nothing
                if has_word(obj, d)
                    change n to n + 1
            change i to i + 1
        if n > best_n
            change best_n to n
            change best to obj
        else
            if rooms_first is 1
                if n > 0
                    if n is best_n
                        if obj is room
                            if best is not room
                                change best to obj
        change obj to obj + 1
    return best

// The room an object ultimately sits in: walk up the tree to the top parent.
block room_of(obj)
    let r = obj
    while r is not in nothing
        change r to parent_of(r)
    return r

// Indent helper for the tree and scope listings.
block indent(depth)
    let i = 0
    while i < depth
        show("  ")
        change i to i + 1

// ---------------------------------------------------------------------------
// tree: the whole object tree, each top-level object (rooms, and anything
// detached) and its contents below it, indented.

verb "tree", "objects" meta
    tree

on tree
    let i = 1
    while i <= object_count
        if i is in nothing
            tree_from(i, 0)
        change i to i + 1

block tree_from(obj, depth)
    indent(depth)
    print_name(obj)
    say ""
    for each x in obj
        tree_from(x, depth + 1)

// ---------------------------------------------------------------------------
// scope: what is reachable from here - the room and what you carry, on into open
// or clear containers and onto supporters, the way the noun matcher sees it.

verb "scope" meta
    scope

on scope
    say "In scope:"
    scope_from(here, 1)
    scope_from(player, 1)

block scope_from(holder, depth)
    for each x in holder
        indent(depth)
        print_name(x)
        say ""
        if see_into(x)
            scope_from(x, depth + 1)

// ---------------------------------------------------------------------------
// fetch (Inform purloin): pull any object into your hands.

verb "fetch", "purloin" meta
    // A debug tool ignores the reach gate (Charles Moore Jr.'s
    // suggestion, 2026-09-14): purloining a beyond thing is the point.
    reachagnostic
    fetch noun

on fetch
    if noun is nothing
        say "Fetch what?"
        stop
    // Purloin pulls the object plainly into your hands, bypassing every
    // rule. Detach it first: a component moved while still marked stays
    // "part of" its new holder (part of the player) and vanishes from the
    // inventory listing (a field report: purloining a component of a
    // character seemed to do nothing). Clear the mark so it lands as an
    // ordinary carried thing; the guard folds away without components.
    if any_components is 1
        now noun is not component
    move noun to player
    show("Fetched ")
    print_name(noun)
    say "."

// warp (Inform gonear): teleport to wherever an object is.

verb "warp", "gonear" meta
    // Reach-agnostic like fetch: warping TO a beyond thing is routine.
    reachagnostic
    warp noun

on warp
    if noun is nothing
        say "Warp where?"
        stop
    let dest = room_of(noun)
    set_here(dest)
    move player to dest
    describe_room

// unmute: hear the background performers. A restless object's prose is
// buffered every turn and spoken only when the performer is in scope (the
// turn loop, docs/01 chapter 16): right for players, blinding while debugging,
// when the say lines sprinkled through a handler are exactly what you need
// to see. UNMUTE lets every offstage voice through, each pulse prefixed
// with the performer's name in brackets so you can tell who speaks from
// where; UNMUTE again turns it back off. In-scope performers are untouched,
// and a performer whose turn printed nothing stays silent either way.

global debug_unmute = 0

verb "unmute" meta
    unmute

on unmute
    if debug_unmute is 0
        change debug_unmute to 1
        say "Offstage voices unmuted."
    else
        change debug_unmute to 0
        say "Offstage voices muted again."

// The performer walk, overridden (a granule block replaces a library block
// of the same name): identical to the library's fire_restless, plus the
// unmute tap at the end, where prose that would have gone unheard is
// spoken anyway behind a [name] tag.
block fire_restless()
    let obj = 1
    while obj <= object_count
        if obj is restless
            if obj is not here
                let r = handler_of(obj)
                if r is not nothing
                    let heard = 0
                    if in_scope(obj)
                        change heard to 1
                    let pp = par_pending
                    mute_begin
                    // The buffer must hold the performer's prose and nothing
                    // else: a pending break stranded by an earlier silent
                    // handler would be flushed by the performer's first say
                    // as a REAL newline into the buffer, and the replay,
                    // adding its own honest gap, would show two (the field
                    // report: an extra blank line before every pulse). Clear
                    // it inside the mute; pp restores the outer state after.
                    change par_pending to 0
                    call_handler(r, ev_each_turn)
                    mute_end
                    change par_pending to pp
                    if heard is 0
                        if in_scope(obj)
                            change heard to 1
                    if heard is 1
                        replay_muted
                    else
                        if debug_unmute is 1
                            let b = mute_buf
                            let n = peek_word(b, 0)
                            if n is not 0
                                par
                                show("[")
                                print_name(obj)
                                show("] ")
                                let i = 0
                                while i < n
                                    show_char(peek_byte(b + 2 + i))
                                    change i to i + 1
        change obj to obj + 1

// ---------------------------------------------------------------------------
// inspect (Inform showobj): an object's location and the attributes it has set.

verb "inspect", "showobj" meta
    // Reach-agnostic like fetch: inspection is not touching.
    reachagnostic
    inspect noun

on inspect
    if noun is nothing
        say "Inspect what?"
        stop
    print_name(noun)
    say ""
    show("  in: ")
    let p = parent_of(noun)
    if p is nothing
        say "nowhere"
    else
        print_name(p)
        say ""
    inspect_attrs(noun)

// The standard attributes that are set on the object, one per line.
block inspect_attrs(obj)
    if obj is container
        say "  container"
    if obj is supporter
        say "  supporter"
    if obj is open
        say "  open"
    if obj is locked
        say "  locked"
    if obj is switchable
        say "  switchable"
    if obj is lit
        say "  lit"
    if obj is worn
        say "  worn"
    if obj is animate
        say "  animate"
    if obj is fixed
        say "  fixed"
    if obj is scenery
        say "  scenery"
    if obj is hidden
        say "  hidden"
    if obj is moved
        say "  moved"
    if obj is seen
        say "  seen"
