//
// PATHFINDING: summon it with `summon.pathfinding`. The player-facing half
// of the way family (docs/01 chapter 8): GO TO a visited room by name, FIND
// a thing you know of, LOOK <direction> to ask what lies that way. The
// engine itself, way_between/way_toward with the crumbs-and-fringe search,
// lives in the core library and is callable without this granule; what the
// granule adds is knowledge and the verbs. Knowledge is the visited set:
// GO TO resolves only rooms the player has stood in, the walk routes only
// through rooms they have seen (path_admits below narrows the search), and
// LOOK names only destinations already visited. Nothing here ever tells the
// player what the map holds beyond their own footsteps.
//
// Summoning the granule also turns every room's `name` words into that
// room's vocabulary (GO TO CHURCHYARD must resolve the churchyard); declare
// `words` on a room to narrow or extend that, exactly as on a thing.
//
// THE WALK. A GO TO or FIND computes the first step, performs it as an
// ordinary go action (doors, refusals, alter lines, and `on enter` all
// behave), and repeats until it arrives. Every intermediate step is a full
// world beat: daemons and timers run, the clock ticks, and the passage is
// marked with one breadcrumb line per room instead of the full description
// (the arrive stride, actions.prelude). The whole walk is one command, so
// one UNDO takes it all back. The walk stops the moment the world pushes
// back: a refused step, a step that lands somewhere unexpected (a teleport,
// a cutscene), or the path dissolving mid-walk; whatever intervened has
// already spoken, and the walk adds nothing over it.
//
// The wording lives here, in the granule, so it ships only when summoned
// (the extended-verbs manner). Reskin any line by redefining its msg_ block.

// 1 while a GO TO or FIND is searching: path_admits then narrows the walk
// to the player's knowledge. An author calling way_toward directly (an NPC
// walking the same graph) is not bound by what the player has seen.
global seek_known = 0

// 1 when the last seek matched two different candidates equally well; the
// verb answers with the honest "which do you mean" ask instead of guessing.
global seek_two = 0

// The knowledge gate (overrides the core's admit-everything default).
block path_admits(r)
    if seek_known is 1
        if r is not visited
            return 0
    return 1

// ---------------------------------------------------------------------------
// Matching typed words against what the player knows.

// Does this object answer for EVERY content word in [lo, hi)? Grammar words
// (articles, prepositions, directions) pass through unjudged; at least one
// content word must be present and all of them must be the object's own.
block seek_fits(o, lo, hi)
    let n = 0
    let i = lo
    while i < hi
        let d = word_dict(i)
        if d is nothing
            return 0
        if peek_byte(d + 6) is 0
            if has_word(o, d) is 0
                return 0
            change n to n + 1
        change i to i + 1
    if n is 0
        return 0
    return 1

// The visited room the words name, or nothing. Only rooms carry `visited`,
// so the visited test is the room test too; an unvisited room stays as
// unknown as a place that does not exist, which is the point.
block seek_room(lo, hi)
    change seek_two to 0
    let best = nothing
    let o = 1
    while o <= object_count
        if o is visited
            if seek_fits(o, lo, hi) is 1
                if best is nothing
                    change best to o
                else
                    change seek_two to 1
        change o to o + 1
    return best

// The thing the words name, searched across the whole world; hidden objects
// stay hidden. Where it stands is judged afterward, by knowledge.
block seek_thing(lo, hi)
    change seek_two to 0
    let best = nothing
    let o = 1
    while o <= object_count
        if o is not hidden
            if seek_fits(o, lo, hi) is 1
                if best is nothing
                    change best to o
                else
                    change seek_two to 1
        change o to o + 1
    return best

// The room ultimately around an object (a room answers for itself).
block room_of(o)
    while parent_of(o) is not nothing
        change o to parent_of(o)
    return o

// ---------------------------------------------------------------------------
// The walk.

// Walk toward room t, one real turn per step. Returns 1 arrived, 0 stopped;
// every refusal has spoken by the time this returns.
block walk_to(t)
    let guard = 0
    while here is not t
        change seek_known to 1
        let w = way_toward(here, t)
        change seek_known to 0
        if w is no_way
            // Dissolved mid-walk (a door swung shut, a daemon intervened):
            // whatever happened has spoken. On the first step this is
            // unreachable; goto_room asks before walking.
            return 0
        let p = exit_prop(w)
        let dest = exit_dest(here, p)
        if any_doors is 1
            if dest is door
                change dest to door_far_side(dest, here)
        if dest is not t
            change striding to 1
        let ok = perform("go", p)
        change striding to 0
        if ok is 0
            return 0
        if here is not dest
            // The world moved the player mid-step; the mover owns the story.
            return 0
        if here is not t
            // An intermediate room is a full world beat: performers, timers,
            // and the clock all run, exactly as if the step had been typed.
            fire_turn
            tick
        change guard to guard + 1
        if guard > object_count
            return 0
    return 1

// ---------------------------------------------------------------------------
// The verbs.

on goto_room
    if topic_lo is topic_hi
        msg_noun_missing
        change refused to 1
        stop
    let t = seek_room(topic_lo, topic_hi)
    if t is nothing
        msg_unknown_place
        change refused to 1
        stop
    if seek_two is 1
        msg_be_specific
        change refused to 1
        stop
    if t is here
        msg_already_there
        change refused to 1
        stop
    change seek_known to 1
    let w = way_toward(here, t)
    change seek_known to 0
    if w is no_way
        msg_no_way_known
        change refused to 1
        stop
    walk_to(t)
    stop

on find_where
    if topic_lo is topic_hi
        msg_noun_missing
        change refused to 1
        stop
    let t = seek_thing(topic_lo, topic_hi)
    if t is nothing
        msg_seek_unknown
        change refused to 1
        stop
    if seek_two is 1
        msg_be_specific
        change refused to 1
        stop
    if in_scope(t)
        msg_find_here(t)
        stop
    let r = room_of(t)
    if r is here
        msg_seek_near(t)
        stop
    if r is not visited
        msg_no_way_known
        change refused to 1
        stop
    change seek_known to 1
    let w = way_toward(here, r)
    change seek_known to 0
    if w is no_way
        msg_no_way_known
        change refused to 1
        stop
    line_seek_notice(r)
    walk_to(r)
    stop

on look_way
    // The parser bound the typed direction to `way` before dispatch.
    let d = exit_dest(here, way)
    if d is nothing
        msg_nothing_that_way
        stop
    if any_doors is 1
        if d is door
            if d is not open
                msg_door_shut_way(d)
                stop
            change d to door_far_side(d, here)
            if d is nothing
                msg_nothing_that_way
                stop
    if d is visited
        msg_way_lies(d)
    else
        msg_way_unknown
    stop

// ---------------------------------------------------------------------------
// The wording and the grammar live in the language companions
// (pathfinding_english.granule and siblings): the loader adds the one
// matching the game's language automatically. The two helpers below are
// mechanics the companions share: the typed direction word, spelled as
// typed so the nautical granule's AFT answers in kind.

// The word index of the typed direction word, or 0 when the line has none.
block dir_word_at()
    let n = word_count
    let i = 1
    while i < n
        let d = word_dict(i)
        if d is not nothing
            if peek_byte(d + 6) is 64
                return i
        change i to i + 1
    return 0

block show_dir_word(at, cap)
    let p = word_pos(at) - 2
    let n = word_len(at)
    let i = 0
    while i < n
        let ch = text_char(p + i)
        if cap is 1
            if i is 0
                if ch >= 97
                    if ch <= 122
                        change ch to ch - 32
        show_char(ch)
        change i to i + 1
    return 0

