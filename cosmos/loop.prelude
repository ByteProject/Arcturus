// loop.prelude
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// The turn loop (docs/01 chapter 3), the heart of a running game. The compiler
// hands control here after printing the banner (the __main__ shim). The loop
// fires the opening event, describes the starting room, then repeats: prompt,
// parse, dispatch the action, fire the per-turn events, count the turn. A `finish`
// in any handler quits, ending the loop.

// The status bar, painted into row 1 of the current upper window. The default is
// empty; summon.statusline overrides it to draw the room/score bar. Factoring it
// out this way lets the conversations menu paint the same bar at the top of its
// window, so the two features coexist, while a game with neither pays nothing.
block status_bar()
    return 0

// How many rows the status bar occupies: 0 by default, 1 once statusline is
// summoned. The conversations menu reads this to know whether to leave room 1 for
// the bar or reclaim it for the topic list, so it never wastes a blank line.
block status_lines()
    return 0

// Is the room name already on screen in a status bar? 0 by default; the
// statusline granule overrides it to 1, and the opening room description
// then skips its title line (the bar says where you are), so the opening
// prose scrolls straight under the bar: Stefan's start-screen design.
// Later looks print the title as usual.
block title_in_bar()
    return 0

// The current rank (docs/01, Scoring): the highest ladder entry at or
// under the score, thresholds computed by the compiler from the summed
// max_score. The packs' msg_score calls this; folds away with any_ranks.
block print_rank()
    let t = ranks_table
    if t is 0
        return 0
    let n = peek_word(t, 0)
    let best = 0
    let i = 0
    while i < n
        if score >= peek_word(t, 1 + i * 2)
            change best to peek_word(t, 2 + i * 2)
        change i to i + 1
    if best is not 0
        print_packed(best)
    return 0

// The author's state qualifier, appended to a listed object: "a fluid
// canister (full)". `tag` is a text property, usually computed (tag block);
// the packs' listing lines call this, and it folds away with any_tagged in
// a game that tags nothing.
block show_tag(obj)
    if any_tagged is 1
        if tag_addr(obj) is not 0
            show(" (")
            show("${obj.tag}")
            show(")")
    return 0

// TAKE ALL's expander: the takeall granule overrides this with the real
// sweep (docs/01 chapter 22); the stub exists so the hand-off call resolves, and it
// folds away with its caller in a game that never summons the granule.
block run_all(act)
    return 0

// The plural sweep: the plurals granule overrides this to run the action on
// every in-scope object whose `plural` vocabulary carries the group word w
// ("take coins"). Stub for the same reason as run_all.
block run_plural(act, w)
    return 0

// One swept item, shared by the takeall and plurals granules: name it, run
// the real action through the full pipeline (an object's own handlers still
// override), then the per-turn pulse: EACH SWEPT ITEM IS A FULL TURN, the
// same rule a chained line follows. The pending break is dropped so the
// sweep prints as one compact report; a daemon that printed text mid-sweep
// already made its own paragraph. Dead code without either granule.
block sweep_one(obj, act)
    change par_pending to 0
    print_name(obj)
    show(": ")
    change noun to obj
    // The verb contract holds inside a sweep too (each item is a full turn);
    // take and drop declare nothing today, so this is one no-op call per item.
    let vetoed = 0
    if any_requires is 1
        change vetoed to check_requires(act)
    if any_binary is 1
        if vetoed is 0
            change vetoed to check_switch(act)
    if vetoed is 0
        dispatch(act)
    // Each swept item is a full turn, so it takes the after pass too
    // (docs/01 chapter 13, step 6; folds away without an `on after` in the game).
    if any_after is 1
        if grain is 0
            if refused is 0
                let aft = after_of(act)
                if aft is not 0
                    dispatch(aft)
    // last_here is captured BEFORE the pulse: a scenery quip answers for the
    // room it ran in, and the pulse may relocate the player (a teleport in
    // each_turn), which is the one way a grain replay can go stale.
    if any_grains is 1
        change last_here to here
    fire_turn
    tick
    change last_act to act
    change last_noun to noun
    change last_second to second
    change last_way to way
    change last_grain to grain
    return 0

// Run a noun LIST through a two-noun action ("put coin and nail in box"):
// the second is already bound, the list's word range waits in
// list_pos..list_end, and each item is a full turn through sweep_one (the
// takeall manner: "gold coin: Done."), stopping at the first refusal, the
// chain rule. An item that names nothing in scope refuses the same way.
block run_noun_list(act)
    let pos = list_pos
    let end = list_end
    change list_pos to 0
    while pos < end
        // The item runs up to the next chain word (or the list's end).
        let cut = pos
        let stop_at = end
        while cut < end
            let d = word_dict(cut)
            if d is not nothing
                if peek_byte(d + 6) is 2
                    change stop_at to cut
                    change cut to end
            if cut is not end
                change cut to cut + 1
        if stop_at > pos
            let obj = match_phrase(pos, stop_at, 0)
            if parse_fault is not 0
                change refused to 1
            if obj is nothing
                change refused to 1
                msg_cant_see
                return 0
            sweep_one(obj, act)
            if refused is not 0
                return 0
        change pos to stop_at + 1
        // Skip a run of chain words (", and").
        let running = 1
        while running is 1
            change running to 0
            if pos < end
                let r2 = word_dict(pos)
                if r2 is not nothing
                    if peek_byte(r2 + 6) is 2
                        change pos to pos + 1
                        change running to 1
    return 0

// Did the player type a word this topic answers to? CORE, not a granule
// block, because two features share it: the infocom_talking presentation
// (ASK X ABOUT Y) and extendedverbs' CONSULT (consult the tome about the
// mine). Only the SUBJECT phrase is scanned: a grammar line with a `text`
// slot handed it over as a word range (topic_lo/topic_hi); a pack still on
// the flag model finds the separator boundary itself. Scanning by position,
// not by skipping the listener's vocabulary, keeps ASK JACK ABOUT JACK
// working (the second "jack" is the subject; the ASK CAPTAIN ABOUT SHIP
// field report is why position, never vocabulary, draws the line). DCE
// drops it in a game with neither feature.
block subject_typed(person, i)
    let n = word_count
    // A grammar line with a `text` slot handed the subject over as a word
    // range (English ASK/TELL): use it exactly. A pack still on the flag
    // model finds the boundary itself, the separator that splits listener
    // from subject.
    let b = 0
    if topic_hi > topic_lo
        change b to topic_lo - 1
        change n to topic_hi
    else
        let w = 1
        while w < n
            if b is 0
                let d = word_dict(w)
                if d is not nothing
                    if is_separator(d)
                        change b to w
            change w to w + 1
        if b is 0
            return 0
    let s = b + 1
    while s < n
        let target = word_dict(s)
        if target is not nothing
            if topic_matches(person, i, target)
                return 1
        change s to s + 1
    return 0

// The post-mortem, after a finish banner: the final score, then the
// classic prompt until the player picks a way out. The answer words are
// whatever the language pack declared for the restart/restore/quit verbs,
// matched by their ACTIONS, so every language works without a line here.
block game_over()
    par
    msg_score
    while true
        par
        // A death offers the way back; a finish (a victory, a completed
        // story) stays final: a won game must stay won. The whole choice
        // folds to the classic prompt in a game with no death statement.
        if any_death is 1
            if died is 1
                // Offer UNDO only on an interpreter that can keep the
                // promise (the undo handshake; Canopus and Haumea both
                // veto honestly on their small machines).
                if undo_off is 1
                    msg_game_over
                else
                    msg_game_over_died
            else
                msg_game_over
        else
            msg_game_over
        prompt
        let n = read_line
        let handled = 0
        let d = word_dict(0)
        if d is not nothing
            if peek_byte(d + 6) is 128
                let act = peek_byte(d + 7)
                if act is action_id("restart")
                    do_restart
                if act is action_id("restore")
                    // A successful restore never returns here (it resumes at
                    // the save point); reaching the next line means failure.
                    let r = do_restore
                    change handled to 1
                    msg_restore_failed
                if act is action_id("undo")
                    if any_death is 1
                        if died is 1
                            // Take back the fatal command (the checkpoint
                            // every turn takes, before it dispatched): on
                            // success restore_undo resumes inside run_turn,
                            // which reports the undo and redescribes the
                            // room, so the lines after the restore are only
                            // reached when the interpreter has no undo to
                            // give, and they say so truthfully (the
                            // handshake gate skips the void attempt
                            // entirely). After a finish, undo falls to
                            // "not one of the choices": a won game stays
                            // won.
                            change handled to 1
                            if undo_off is 1
                                msg_undo_unavailable
                            else
                                let u = do_restore_undo
                                msg_undo_unavailable
                if act is action_id("quit")
                    do_quit
        if handled is 0
            msg_game_over_unknown

// The screen-establishment seam: a granule that owns screen furniture (the
// status bar) overrides this to put its windows up BEFORE `on start` prints
// a word, so the first line of start text is never painted under a later
// split. The default is empty and a statement-call to an empty block emits
// nothing: games without such a granule pay zero bytes for the seam.
block screen_ready()

block run_game()
    move player to here
    // The start room is visited by definition (and never scores: you did
    // not earn arriving where you begin).
    now here is visited
    // THE UNDO HANDSHAKE, static half: arcc sets Flags 2 bit 4 (the game
    // wants undo, S 11.1) and an interpreter that cannot undo clears it
    // back. Read the answer once, before the first prompt, so UNDO and
    // the death prompt never promise what the machine already declined
    // (Canopus on the Model 4, Haumea's 64K CPC). The dynamic half is
    // the -1 backstop at the checkpoint in run_turn.
    undo_check
    // At first boot this clear is a no-op (no band exists before the first
    // real draw); after a RESTART it is the difference between a fresh game
    // and the dead game's picture hanging over it, since restart rewinds
    // memory (shown_image included) without touching the screen.
    if any_images is 1
        image_reset
    screen_ready
    // NOTHING STARTS FLUSH UNDER THE STATUS BAR (Stefan's spacing rule,
    // 2026-07-27, superseding the July 18 flush-title look): a pending
    // break here means the first thing printed, an `on start` intro or
    // the banner itself, arrives one breathing line below the bar. On a
    // bare screen with no bar the blank leads the transcript, which reads
    // just as well.
    par
    // `on start` runs FIRST (Inform's Initialise order): the game sets up its
    // world and its screen (colours, which erase the screen to repaint it)
    // before anything is drawn. THEN the library prints the banner, onto the
    // screen the game just established, so setting zcolor.background in
    // `on start` no longer erases the banner out from under itself.
    run_free(ev_start)
    // The second half of the spacing rule: a break between the `on start`
    // text and the banner. par is a flag, not a counter, so on a silent
    // start the two marks collapse into the one blank under the bar, and
    // an intro gets exactly one blank on each side. This makes true what
    // an older comment here only claimed.
    par
    if auto_banner is 1
        print_banner
    // Separate the banner (and any text `on start` printed above it) from the
    // opening room description: one blank line, collapsed with describe_room's.
    par
    if title_in_bar is 1
        change hide_title to 1
    describe_room
    while true
        prompt
        run_chain(parse)
        // Snapshot the line's unrecognized word (verb or noun, if any) so a
        // following "oops" can correct it. Done here, after both the understood
        // and the unknown-verb paths, so a mistyped verb is correctable too.
        // After a chained line the buffer holds its last command, so oops
        // corrects exactly the command the player last saw fail.
        note_oops

// Carry out a parsed command, then any commands chained after it on the same
// line ("take the lamp and open the door then go north", docs/01 chapter 14).
// The chain stops the moment a command fails: a parse failure, or a turn a
// refusal path could not carry out (`refused`, set by the library's refusals
// and settable by a story handler). What was already done stays done.
block run_chain(act)
    while true
        change refused to 0
        if act is 0
            if parse_fault is 1
                msg_cant_see
            else
                if parse_fault is 2
                    msg_extra_words
                else
                    if parse_fault is 3
                        msg_be_specific
                    else
                        if parse_fault is 4
                            msg_unknown_word
                        else
                            // Fault 5: a pronoun with nothing to refer to
                            // (IT before anything was named, THEM with no
                            // group, a Spanish clitic left unbound).
                            if parse_fault is 5
                                msg_no_it
                            else
                                if word_count is not 0
                                    msg_no_verb
            return 0
        run_turn(act)
        if refused is not 0
            return 0
        if chain_pos is 0
            return 0
        // Remember this command's action: a verb-less next segment borrows
        // it ("take lamp and box", the noun lists of docs/01 chapter 14).
        change chain_prev to act
        // Each chained command's response is its own paragraph.
        par
        change act to chain_next

// Run an action as part of the CURRENT turn, the way the player's own
// command would dispatch it: Inform's <<take book>>, Dialog's (try ...).
// Reached through the perform intrinsic, perform("take", book): the action
// name resolves at compile time, the operands default to nothing, and a
// direction rides the way slot (perform("go", west)), because go reads
// way, never noun. The full pipeline runs: the can't/won't refusals, the
// handler chain, the messages, and the after phase; then the enclosing
// command's own operands come back, so the outer turn (and a later AGAIN)
// still sees what the player actually typed. Returns 1 when the action
// carried, 0 when it refused; the enclosing turn's own refused flag is
// untouched either way. No new undo point and no extra turn tick: it is
// one turn's work. Costs nothing unless called (DCE).
block cosmos_perform(act, obj, other)
    let sn = noun
    let ss = second
    let sw = way
    let sg = grain
    let sr = refused
    let sv = 0
    if any_verb_read is 1
        // A performed action has no typed word behind it: verb_trigger reads
        // 0 inside, so an author's phrasing branch falls to its default.
        change sv to verb_trigger
        change verb_trigger to 0
    change refused to 0
    change grain to 0
    if act is action_id("go")
        change way to obj
        change noun to nothing
    else
        change noun to obj
        change way to nothing
    change second to other
    dispatch(act)
    if any_after is 1
        if refused is 0
            let aft = after_of(act)
            if aft is not 0
                dispatch(aft)
    let ok = 1
    if refused is not 0
        change ok to 0
    change noun to sn
    change second to ss
    change way to sw
    change grain to sg
    change refused to sr
    if any_verb_read is 1
        change verb_trigger to sv
    return ok

// The declarative verb contract (the verbs overhaul, phase 2): enforce what
// this action requires of its operands BEFORE any handler runs, so an object's
// override owns the response and never the validation. The bits come from
// requires_map (compiler-emitted, per action, from the `requires`
// declarations); a slot the grammar requires but the player left empty never
// reaches here (the loop's bare-command ask refuses it earlier still), and a
// grammar-optional empty slot passes through untested. Read arithmetically,
// low bit first (the source language has no bitwise operators; the ambience
// deck's manner). Returns 1 on a refusal, message already spoken.
// The switch contract (the binary model, docs/01 chapters 6 and 12): a
// switch verb's VALIDATION, library-owned like every contract, so an
// object's flavor handler owns the response to a valid flip and never
// the state check. The thing must be binary, and must not already be in
// the asked state. Folds away (any_binary) in a game with nothing to
// flip; a non-binary noun is refused by the default handler either way.
block check_switch(act)
    if noun is nothing
        return 0
    if noun is not binary
        return 0
    // The state read: a glow thing's truth is `lit` (author flavor
    // handlers have always flipped lit, and the default flips both), a
    // plain binary's is `active`.
    let cur = 0
    if noun is glow
        if noun is lit
            change cur to 1
    else
        if noun is active
            change cur to 1
    if act is action_id("switch_on")
        if cur is 1
            change refused to 1
            msg_already_on
            return 1
        return 0
    if act is action_id("switch_off")
        if cur is 0
            change refused to 1
            msg_already_off
            return 1
    return 0

block check_requires(act)
    let r = requires_of(act)
    if r is 0
        return 0
    // Each branch is doubly guarded: the per-bit fold (req_*, compile time:
    // does ANY action declare this bit?) and the mask (run time: does THIS
    // action?). A game whose verbs never use a bit never compiles its branch,
    // and the second-slot message drops with its branch.
    let h = r / 2
    if req_noun_carried is 1
        if r - h - h is 1
            if noun is not nothing
                if parent_of(noun) is not player
                    // The repair seam: the default refuses; summon.foresight
                    // overrides this block to try the implicit take first
                    // ("(taking the pebble first)"), probe-guarded so it
                    // never promises what the take cannot deliver.
                    if requires_failed_carried(noun) is 1
                        return 1
    change r to h
    change h to r / 2
    if req_noun_animate is 1
        if r - h - h is 1
            if noun is not nothing
                if noun is not animate
                    change refused to 1
                    msg_only_animate
                    return 1
    change r to h
    change h to r / 2
    if req_second_carried is 1
        if r - h - h is 1
            if second is not nothing
                if parent_of(second) is not player
                    change refused to 1
                    msg_not_holding_second
                    return 1
    change r to h
    change h to r / 2
    if req_second_animate is 1
        if r - h - h is 1
            if second is not nothing
                if second is not animate
                    change refused to 1
                    msg_only_animate
                    return 1
    return 0

// The sealed-away refusal, the container half of the foresight seam: the
// named thing is known (seen) but shut inside shut_in. The default refuses
// and costs no turn; the granule's override opens the container when the
// open is certain to succeed and lets the typed command continue. Returns
// 1 refused (message spoken), 0 repaired (shut_in cleared, turn goes on).
block shut_in_refused()
    change meta_turn to 1
    change refused to 1
    msg_open_first
    return 1

// The carried-requirement failure, the foresight seam: the default refuses
// with the library line. summon.foresight redefines this block with the
// repair (docs/01 chapter 22): probe first, promise only what the default take will
// certainly do, fall back to promise-then-run only where author code makes
// the outcome unknowable. Returns 1 refused (message spoken), 0 repaired
// (the object is now carried and the turn goes on).
block requires_failed_carried(obj)
    change refused to 1
    msg_not_holding
    return 1

// The light watch (a field report: LIGHT LANTERN in the dark answered only
// the lantern's own line, leaving the player to type LOOK for the room they
// could suddenly see). st packs the turn's start: the room doubled, plus 1
// when the player stood in darkness. Darkness lifting shows the room,
// picture and all; darkness falling says where that leaves you. Only
// without a move: walking through a doorway already describes (or reports
// the darkness) through arrive, and must not do so twice. Refused turns
// changed nothing. Dead code in an always-lit game: the one call site
// folds away with any_dark, and DCE reclaims the block.
block light_check(st)
    if refused is not 0
        return 0
    let dk = st - (st / 2) * 2
    let rm = st / 2
    if here is not rm
        return 0
    if dk is 1
        if is_lit is 1
            describe_room
        return 0
    if is_lit is 0
        par
        msg_dark_room

// Carry out one understood command. Undo is handled here, not through dispatch:
// every other command first takes an undo checkpoint (save_undo), so that a later
// undo rewinds to just before it. When save_undo returns 2 the machine has just
// resumed here via restore_undo, meaning the previous turn is being taken back.
block run_turn(act)
    change meta_turn to 0
    // Fresh turn: not a replay until the AGAIN branch below says so. The
    // whole replay flag folds away in a game with no conversation topics,
    // the only thing that reads the typed words at dispatch time.
    if any_topics is 1
        change replaying to 0
    // The named object is known but shut inside a closed container. The
    // default tells the player to open it; summon.foresight overrides the
    // seam to open it FOR them when the promise is certain ("(opening the
    // oak chest first)"), and the turn then proceeds as typed.
    if shut_in is not nothing
        if shut_in_refused is 1
            return 0
    if act is action_id("undo")
        change meta_turn to 1
        do_undo
        return 0
    if act is action_id("oops")
        change act to fix_oops
        if act is 0
            change meta_turn to 1
            change refused to 1
            return 0
    if act is action_id("again")
        if last_act is 0
            change meta_turn to 1
            change refused to 1
            msg_nothing_again
            return 0
        // The world may have moved on since the command was typed: an
        // operand that has left scope refuses now, exactly as retyping the
        // command would, instead of acting on a ghost (the field report was
        // a lantern spirited to nothing, forever examinable through AGAIN).
        // A scenery quip is bound to its room the same way.
        if last_noun is not nothing
            if any_reach is 1
                // A noun the parser bound through the reach_unscoped seam
                // (docs/01 chapter 14: a verb that legitimately names
                // something out of scope, FOLLOW being the classic) replays
                // without the ghost refusal: being elsewhere is its normal
                // state, and the verb's own handler owns validity, AGAIN
                // included. Only an ordinarily-bound noun that has since
                // left scope is a ghost. Both arms spelled out so the
                // static fold keeps a seamless game byte-identical.
                if not in_scope(last_noun)
                    if last_reached is 0
                        change meta_turn to 1
                        change refused to 1
                        msg_cant_see
                        return 0
            else
                if not in_scope(last_noun)
                    change meta_turn to 1
                    change refused to 1
                    msg_cant_see
                    return 0
        if last_second is not nothing
            if not in_scope(last_second)
                change meta_turn to 1
                change refused to 1
                msg_cant_see
                return 0
        if any_grains is 1
            if last_grain is not 0
                if here is not last_here
                    change meta_turn to 1
                    change refused to 1
                    msg_cant_see
                    return 0
        // Replay the previous command by restoring its resolved operands, then
        // fall through to dispatch it exactly as a fresh turn. `replaying`
        // says so for the rest of the turn: the typed words are still
        // "again", so anything that reads them at dispatch time (a topic's
        // subject lives in the words, not in noun/second) must fall back to
        // what it answered last time instead of scanning them.
        if any_topics is 1
            change replaying to 1
        change act to last_act
        change noun to last_noun
        change second to last_second
        change way to last_way
        change grain to last_grain
        if any_reach is 1
            change reached to last_reached
        if any_verb_read is 1
            change verb_trigger to last_trigger
    // The bare-command ask (the verbs overhaul, completed): a command whose
    // grammar wanted a noun that was never typed refuses HERE, library-owned,
    // before any handler and before the undo checkpoint, custom verbs and
    // standard verbs alike. The message echoes the verb word as typed; no
    // move is consumed. The resolvers set the mark, remap_action unmarks the
    // way-borne idioms (GET OUT), and a sweep or noun list never carries it.
    if incomplete is 1
        change incomplete to 0
        change meta_turn to 1
        change refused to 1
        msg_noun_missing
        return 0
    let r = do_save_undo
    // The dynamic half of the undo handshake: -1 (0xFFFF) is the opcode's
    // own "unable to provide this feature" (S 15). Latch it, so a terp
    // that left the header bit alone but answers honestly is still heard.
    if r + 1 is 0
        change undo_off to 1
    if r is 2
        change meta_turn to 1
        // The rewound state may date from the middle of a chained line or
        // carry a pending sweep hand-off; taking a turn back must not
        // replay either. Each guard folds away without its granule.
        change chain_pos to 0
        change list_pos to 0
        if any_allwords is 1
            change all_go to 0
        if any_plurals is 1
            change plural_go to 0
        // The rewound shown_image describes a screen the undo never touched
        // (the undone turn may have drawn): forget and repaint from truth.
        if any_images is 1
            image_reset
        msg_undone
        par
        describe_room
        return 0
    // A pending sweep (TAKE ALL, "take coins") replaces the ordinary
    // dispatch: one undo checkpoint for the whole sweep (it is one typed
    // command), each swept item still a full turn inside the granule.
    if any_allwords is 1
        if all_go is 1
            change all_go to 0
            run_all(act)
            return 0
    if any_plurals is 1
        if plural_go is not 0
            let w = plural_go
            change plural_go to 0
            run_plural(act, w)
            return 0
    // A noun list in a two-noun command ("put coin and nail in box"): the
    // second is bound, the items run one by one, each a full turn.
    if list_pos is not 0
        run_noun_list(act)
        return 0
    // Remember whether the player stood in darkness BEFORE the action, so a
    // turn that brings light (switching the lantern on in the dark) can show
    // the room it just revealed, and a turn that kills the light can say
    // where that leaves you. Folds away in an always-lit game (any_dark).
    // The light watch's snapshot: r (the undo result, long since read) is
    // reused to carry the turn's start packed as here doubled, plus 1 when
    // the player stood in darkness. Both stores fold away in an always-lit
    // game, and no new local is spent (run_turn is a busy routine).
    if any_dark is 1
        change r to here + here
        if is_lit is 0
            change r to r + 1
    // The verb contract, BEFORE dispatch (the verbs overhaul, phase 2): a
    // turn whose operands fail what the action requires is refused here,
    // library-owned, and no handler ever sees it. perform() does not pass
    // through this: an author performing an action means it.
    if any_requires is 1
        if check_requires(act) is 1
            return 0
    if any_binary is 1
        if check_switch(act) is 1
            return 0
    dispatch(act)
    // The after phase: the action ran; if nothing refused it, the `on after`
    // handlers walk the same chain under the action's synthetic after number
    // (docs/01 chapter 13 step 6). The library's can't/won't paths all set
    // `refused`, and a story handler that refuses should too. A grain turn
    // is a scenery quip, not a world action, so it takes no after pass. In
    // a game with no `on after` anywhere, any_after folds all this away.
    if any_after is 1
        if grain is 0
            if refused is 0
                let aft = after_of(act)
                if aft is not 0
                    dispatch(aft)
    // Light changed hands this turn: the light watch reads the packed
    // snapshot back and speaks. Folds away with any_dark.
    if any_dark is 1
        light_check(r)
    if meta_turn is 0
        // last_here is captured BEFORE the pulse: a scenery quip answers for
        // the room it ran in, and the pulse may relocate the player (a
        // teleport in each_turn), the one way a grain replay can go stale.
        if any_grains is 1
            change last_here to here
        fire_turn
        tick
        // Remember a real (non-meta) command so a later "again" can repeat it.
        change last_act to act
        change last_noun to noun
        change last_second to second
        change last_way to way
        change last_grain to grain
        if any_reach is 1
            change last_reached to reached
        if any_verb_read is 1
            change last_trigger to verb_trigger
    return 0

// Read the interpreter's side of the undo handshake: Flags 2 low byte,
// bit 4 (value 16). The game set the bit at compile time; a cleared bit
// is the interpreter's veto (S 11.1), latched here as undo_off. The
// arithmetic extracts one bit without a bitwise op, the
// transcript_active manner.
block undo_check()
    let f = peek_byte(17)
    let h = f / 16
    let odd = h / 2
    if h - odd - odd is 0
        change undo_off to 1

// Undo the previous turn. restore_undo, on success, resumes at the save_undo in
// run_turn (it does not return here); so reaching the line after it means the
// undo failed, and reaching here with no turns yet means there is nothing to take
// back. An interpreter that declared no-undo (undo_off, either handshake
// channel) is answered with the truth instead: nothing is attempted into
// the void, and the wording never claims an empty history it cannot know.
block do_undo()
    change refused to 1
    if undo_off is 1
        msg_undo_unavailable
        return 0
    if turns is 0
        msg_cant_undo
        return 0
    let r = do_restore_undo
    // A restore that failed despite a capable-looking interpreter is
    // still the machine declining, not an empty history.
    msg_undo_unavailable
    return 0

// Fire the current room's `on enter` (the loop and the go verb call this after
// the player arrives). The handler may move the player elsewhere (a bounce).
block fire_enter()
    if here is not nothing
        let r = handler_of(here)
        if r is not nothing
            call_handler(r, ev_enter)

// The per-turn pulse, in reach order: the room's `on each_turn`, then every
// in-scope object's (a daemon on a thing, active while the thing is here or
// carried), then the free `on each_turn` rules, then the after/every schedule.
// Each handler's `when` guard is compiled into the handler itself; the schedule
// counts down and fires anything now due.
block fire_turn()
    if here is not nothing
        let r = handler_of(here)
        if r is not nothing
            par
            call_handler(r, ev_each_turn)
    fire_object_turns(here)
    fire_object_turns(player)
    // The background performers (restless, docs/01): work follows the
    // performer's nature, prose follows scope. Folds away entirely in a
    // game with no restless object.
    if any_restless is 1
        fire_restless
    par
    run_free(ev_each_turn)
    par
    tick_timers
    // Score notification (the coupled NOTIFY rule): when the author enabled
    // it and the score moved this turn, say so in the classic bracket line.
    // One compare per turn, and the whole watch folds away in a game that
    // never writes `notify`.
    if any_notify is 1
        if notify is not 0
            if score is not last_score
                par
                msg_notify_line(score - last_score)
        change last_score to score
    // The picture follows the scene LIVE: a turn that changed the room's
    // arc_image (the door swings open, the drawbridge falls) or its light
    // repaints the band now, not on the next LOOK, because a picture lagging
    // its own scene reads as a bug in a way stale prose does not. The dedup
    // in draw_room_image makes the quiet turn cost one property read.
    if any_images is 1
        draw_room_image

// Fire the `on each_turn` of every object within `holder` that the player can see
// into it, recursing into supporters and open or clear containers the same way
// scope does, so an object's daemon runs exactly while the object is in scope.
// A restless object is skipped here: the performer walk below owns its firing
// (once per turn, wherever it is), so nothing ever fires twice. The firing is
// spelled out in BOTH arms rather than factored into a helper, so the static
// fold leaves a restless-free game byte-identical to one built before the
// feature existed.
block fire_object_turns(holder)
    for each obj in holder
        if obj is not hidden
            if any_restless is 1
                if obj is not restless
                    let r = handler_of(obj)
                    if r is not nothing
                        par
                        call_handler(r, ev_each_turn)
            else
                let r2 = handler_of(obj)
                if r2 is not nothing
                    par
                    call_handler(r2, ev_each_turn)
            if see_into(obj)
                fire_object_turns(obj)

// The background performers (docs/01, restless): every restless object's
// `on each_turn` fires EVERY turn, wherever the object is. The firing is
// always buffered (the mute buffer, z-machine output stream 3), and the
// buffer is spoken afterward if the performer is in scope at EITHER end
// of its turn: standing before you, arriving as you watch, or leaving
// before your eyes are all heard; a turn taken wholly offstage is
// silence. So the author writes `say` unconditionally and the system
// decides audibility, arrivals included. The pending paragraph break is
// saved and CLEARED around the buffered call, both directions guarded: a
// `par` swallowed inside never leaks a stray blank line out, and a break
// stranded outside never flushes into the buffer as a doubled gap. A restless room the player stands in already fired
// through the room path above, so `here` is skipped. Reached only
// behind any_restless (compile time).
block fire_restless()
    let obj = 1
    while obj <= object_count
        if obj is restless
            if obj is not here
                let r = handler_of(obj)
                if r is not nothing
                    let heard = 0
                    if in_scope(obj)
                        change heard to 1
                    let pp = par_pending
                    mute_begin
                    // The buffer must hold the performer's prose and nothing
                    // else: a pending break stranded by an earlier silent
                    // handler would be flushed by the performer's first say
                    // as a REAL newline into the buffer, and the replay,
                    // adding its own honest gap, would show two (the field
                    // report: an extra blank line before every pulse). Clear
                    // it inside the mute; pp restores the outer state after.
                    change par_pending to 0
                    call_handler(r, ev_each_turn)
                    mute_end
                    change par_pending to pp
                    if heard is 0
                        if in_scope(obj)
                            change heard to 1
                    if heard is 1
                        replay_muted
        change obj to obj + 1

// Speak what the last buffered firing printed: the mute buffer is a
// stream-3 table, a length word then the text bytes.
block replay_muted()
    let b = mute_buf
    let n = peek_word(b, 0)
    if n is not 0
        par
        // show_char prints raw and never flushes the pending break; an
        // empty show does, so the replay gets its blank line like any
        // spoken pulse.
        show("")
        let i = 0
        while i < n
            show_char(peek_byte(b + 2 + i))
            change i to i + 1

// Draw the current room's picture (arc_image, B11), or clear the band when the
// room has none. Only reached behind `any_images` (compile-time) and only draws
// on an interpreter that reports picture support (pictures_available, run time),
// so a text-only interpreter never issues the opcode. The `shown_image` dedup is
// the performance guard Stefan asked for: a re-LOOK in the same room changes
// nothing, so the picture is never reloaded (a retro target would otherwise
// re-decompress its image on every look). A game can override this block to
// change the rendering policy. The mode operand is arc_mode, the game's picture
// mode (band height in text rows, 9 or 12), so the interpreter knows the band
// size from the opcode alone, without loading the picture.
block draw_room_image()
    if pictures_available is 1
        let id = image_of(here)
        // Darkness is a scene too (Stefan's rule): in the dark the band shows
        // the game's darkness picture (arc_image_dark, which sema insists on
        // when darkness is reachable), never a stale leftover from the last
        // lit room. The whole branch folds away in an always-lit game.
        if any_dark is 1
            if is_lit is 0
                change id to arc_image_dark
        if id is not shown_image
            draw_image(id, arc_mode)
            change shown_image to id
            // The bar settles AFTER the band (Stefan's rule, the second
            // Shawn invariant): on an interpreter that releases rows when
            // the band changes, the bar's physical spot moves with it, so
            // every real image change re-seats the bar before any text
            // flows. Behind the dedup, so a quiet LOOK repaints nothing;
            // an empty screen_ready (no bar granule) folds away with the
            // call.
            screen_ready

// Force the next draw: the physical band may hold a picture the CURRENT world
// state never drew, because memory moved without the screen moving (a restore,
// an undo, a restart, each rewinds shown_image while the interpreter's band
// keeps showing what it showed). Clear the band, forget, and let the caller's
// describe_room paint the right picture; a clear before any picture was ever
// drawn is a no-op by contract, so the boot call costs nothing visible.
block image_reset()
    if pictures_available is 1
        draw_image(0, arc_mode)
        change shown_image to 0

// Describe the current room: its name, its description, and what it contains.
// The title line adds where the player stands when nested inside or on
// something ("Crypt (on the altar)"): the wording is the language layer's
// line_nested, and the whole check folds away, byte-identical, in a game
// with nothing to climb into (any_enterable).
// Does this object belong to the room's combined listing sentence, as
// opposed to owning a paragraph (appearance, unmoved intro) or staying
// silent (player, hidden, concealed, scenery)? Both describe_room's
// count and the language layer's printing run ask THIS block, so the
// passes cannot drift apart. The any_appearance check folds away at
// compile time in a game without the feature, as everywhere.
block room_plain(obj)
    if obj is player
        return 0
    if obj is hidden
        return 0
    if obj is concealed
        return 0
    if obj is scenery
        return 0
    if any_appearance is 1
        if appearance_addr(obj) is not nothing
            return 0
    if intro_addr(obj) is not nothing and obj is not moved
        return 0
    return 1


// The existence walk (docs/01 chapter 3): an object declared `in a, b` is
// FULLY PRESENT in every listed room, but it lives in one room of the
// object tree, so the describer's tree walks cannot see it in the others.
// These blocks fill that gap. They walk all objects; a room description
// runs once per look, so the walk stays off the hot paths, and in a game
// without the existence form every call folds away (any_presence) and
// dead-code elimination drops the blocks. is_presence itself folds to a
// constant unless both multi-room forms are live in one game, where it
// reads the compiler's 1-byte marker, so sight objects (`spans`, referable
// only) never enter these walks.

// The next existence object after index `prev` that belongs to this
// room's combined sentence: standing here beyond the tree, and plain by
// room_plain, the exact predicate the tree walk applies. Returns nothing
// when the walk is done. (`prev`, not `after`: after is the handler
// timing keyword.)
block presence_next(prev)
    let i = prev + 1
    while i <= object_count
        if is_presence(i) is 1
            if parent_of(i) is not here
                if spans_here(i)
                    if room_plain(i) is 1
                        return i
        change i to i + 1
    return nothing

// The paragraphs of the existence objects standing here beyond the tree
// (appearance, unmoved intro), and the count of the plain ones for the
// combined sentence. A MIRROR of describe_room's inline tree pass; the
// two must stay in step, so an existence object reads identically in its
// home room and in every other room it exists in. (No player test: the
// player is movable and can never be an existence object.)
block presence_describe()
    let n = 0
    let i = 1
    while i <= object_count
        if is_presence(i) is 1
            if parent_of(i) is not here
                if spans_here(i)
                    if i is not hidden and i is not concealed
                        if any_appearance is 1
                            if appearance_addr(i) is not nothing
                                par
                                say i.appearance
                            else
                                if intro_addr(i) is not nothing and i is not moved
                                    par
                                    say i.intro
                        else
                            if intro_addr(i) is not nothing and i is not moved
                                par
                                say i.intro
                    if room_plain(i) is 1
                        change n to n + 1
        change i to i + 1
    return n

// The single-item sentence when that one item is an existence object
// standing here beyond the tree: the tree walk found nothing to speak,
// so the language layer's list_item speaks it, keeping any override's
// wording.
block list_presence_one()
    let p = presence_next(0)
    if p is not nothing
        list_item(p)


block describe_room()
    par
    // The picture draws BEFORE the darkness gate: a dark room shows its
    // darkness picture over the darkness message, not the previous room's
    // scene (draw_room_image chooses the dark id itself).
    if any_images is 1
        draw_room_image
    if is_lit is 0
        msg_dark_room
        return
    if hide_title is 1
        change hide_title to 0
    else
        // The location title prints bold, the classic library presentation;
        // the nested suffix ("in the chair") stays roman. An interpreter
        // without styles ignores set_style, so nothing changes on paper.
        if any_enterable is 1
            set_style(2)
            print_name(here)
            set_style(0)
            if parent_of(player) is not here
                line_nested(parent_of(player))
            new_line
        else
            set_style(2)
            say here
            set_style(0)
    if desc_addr(here) is not nothing
        say here.desc
    // Two shapes of the same loop body, chosen at compile time
    // (any_appearance): an object with an `appearance` ALWAYS owns its
    // paragraph (Inform's describe, Dialog's appearance), before intro's
    // until-moved rule; a game without one keeps the original body,
    // byte-identical. The plain items are only COUNTED here: they all
    // land in one combined sentence after the paragraphs (Cosmos 1.5.0,
    // the adopters' request; Stefan's ruling: separate items below the
    // room description only if they have their own intro line). The
    // count and the printing share one predicate, room_plain, so the
    // two passes can never disagree.
    let listed = 0
    for each obj in here
        if obj is not player and obj is not hidden and obj is not concealed
            if any_appearance is 1
                if appearance_addr(obj) is not nothing
                    par
                    say obj.appearance
                else
                    if intro_addr(obj) is not nothing and obj is not moved
                        par
                        say obj.intro
            else
                if intro_addr(obj) is not nothing and obj is not moved
                    par
                    say obj.intro
        if room_plain(obj) is 1
            change listed to listed + 1
    // The existence objects standing here beyond the tree (docs/01 chapter
    // 3) speak their paragraphs and join the count; folds away in a game
    // without the form.
    if any_presence is 1
        change listed to listed + presence_describe
    if listed is not 0
        par
        list_room(listed)
    // The scenery pass (constant scenery_contents = 1, the PunyInform
    // OPTIONAL_PRINT_SCENERY_CONTENTS bridge): what sits on or in a
    // scenery holder gets its own paragraph ("On the table you can see
    // a jar."), worded by the language layer. Off by default; folds away.
    if any_scenery_contents is 1
        for each obj in here
            if obj is scenery and obj is not hidden and obj is not concealed
                scenery_holder_line(obj)

// How many digits a non-negative number prints as (scores and turn counts stay
// well under five). Used to right-align the score block without a string length.
block status_digits(n)
    if n < 10
        return 1
    if n < 100
        return 2
    if n < 1000
        return 3
    return 4
