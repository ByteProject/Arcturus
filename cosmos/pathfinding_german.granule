// pathfinding_german.granule
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// The pathfinding granule's GERMAN wording and grammar: the loader adds
// this companion automatically when summon.pathfinding meets a German game
// (docs/01 chapter 22, language companions). The logic stays in
// pathfinding.granule. Wording written natively, never calqued; the
// direction frames use "in Richtung", which carries both the compass
// ("in Richtung Norden") and any future nautical wording without bending.

// GEH ZU <ort> in all three contractions; FINDE and SUCHE walk to what
// you know; SCHAU <richtung> asks what lies that way, with and without
// the natural "nach".

enhance verb "geh"
    goto_room zu text
    goto_room zur text
    goto_room zum text

verb "finde", "find", "suche", "such"
    find_where text

enhance verb "schau"
    look_way direction
    look_way nach direction

block line_stride()
    say "(durch ${the:acc here})"

block line_seek_notice(r)
    say "(du machst dich auf den Weg zu ${the:dat r})"

block msg_already_there()
    say "Da bist du doch schon."

block msg_no_way_known()
    say "Du kennst keinen Weg dorthin."

block msg_unknown_place()
    say "Diesen Ort kennst du nicht."

block msg_seek_unknown()
    say "Davon weißt du nichts."

block msg_find_here(o)
    say "${The o} ist doch genau hier."

block msg_seek_near(o)
    say "${The o} müsste hier irgendwo sein."

block msg_nothing_that_way()
    say "Dort liegt nichts."

block msg_door_shut_way(d)
    let at = dir_word_at
    if at is 0
        say "${The d} versperrt dort den Weg."
        return 0
    show("${The d} versperrt den Weg in Richtung ")
    show_dir_word(at, 1)
    say "."

block msg_way_lies(d)
    let at = dir_word_at
    if at is 0
        say "Dort liegt ${the d}."
        return 0
    show("In Richtung ")
    show_dir_word(at, 1)
    say " liegt ${the d}."

block msg_way_unknown()
    let at = dir_word_at
    if at is 0
        say "Der Weg dort ist offen, aber du bist ihn noch nie gegangen."
        return 0
    show("Der Weg in Richtung ")
    show_dir_word(at, 1)
    say " ist offen, aber du bist ihn noch nie gegangen."
