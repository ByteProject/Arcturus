// dispatch.prelude
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// The action pipeline (docs/01 chapter 13), written in Arcturus. Given an action,
// it walks the chain most-specific first - the noun, then the room - calling each
// object's react routine (wired by the compiler) and stopping at the first that
// consumes the action (returns 1). A react routine runs the object's own
// handlers and its kind chain.
//
// The chain is most-specific first: the noun, then the room, then the
// free-standing rules and the Cosmos default verbs (react_free). Each link may
// consume the action (return 1); the first that does ends the walk.

// What `action` reads: the action this turn is running. The dispatcher is
// the one place every action passes through, so one store here serves
// handlers, grains, and any block they call. Folds away (any_action_read)
// in a game whose code never asks, so it costs nothing unused.
global cur_action = 0

// The body step's seam: run the current body's `as player` handlers. The
// maniacswap granule replaces it to keep a swap's own after pass from
// being answered by the body just taken over (the swap is no action of
// that body's). Referenced only behind any_asplayer, so DCE drops it in
// every game without such a handler.
block asplayer_step(action)
    return asplayer_react(action)

block dispatch(action)
    if any_action_read is 1
        change cur_action to action
    // A handler that alters speaks the report; the mark lives for one
    // action. Folds away in a game that never alters.
    if any_alter is 1
        change altered to 0
    if grain is not 0
        run_grain(grain, action)
        return
    // Out-of-world actions (score, save, restore, restart, quit) never touch
    // the world: no object, recipient, or room handler sees them, exactly as
    // Inform and PunyInform mark their meta verbs. The compiler numbers them
    // past meta_floor, so one compare routes them straight to the free
    // rules (a story still overrides them there, with a free `on score`).
    if action >= meta_floor
        if any_unruled is 1
            let g = run_free(action)
            if g is 0
                msg_cant_do
            return
        run_free(action)
        return
    // The body first (`on <verb> as player`, summon.maniacswap; docs/01
    // chapter 22): what the character the player is now does, before what
    // is done to the thing acted on, so a body's limits gate everything
    // after them. Folds away in a game with no such handler.
    if any_asplayer is 1
        if asplayer_step(action) is 1
            return
    if noun is not nothing
        let r = handler_of(noun)
        if r is not nothing
            if call_handler(r, action) is 1
                return
    // The second noun's handlers come next: the RECIPIENT of a give or show,
    // the container of a put, may answer for itself ("give chip to vlad"
    // runs Vlad's own `on give`), the way Inform consults the second's life.
    // Only when there IS a first noun to act on, though: an incomplete "give to
    // vlad" has nothing being given, so the recipient has nothing to react to
    // (the loop's central ask already refuses that command before dispatch;
    // this guard keeps the invariant for any other nothing-noun path).
    if second is not nothing
        if second is not noun
            if noun is not nothing
                let s2 = handler_of(second)
                if s2 is not nothing
                    if call_handler(s2, action) is 1
                        return
    if here is not nothing
        let s = handler_of(here)
        if s is not nothing
            if call_handler(s, action) is 1
                return
    // The refusal tail (Stefan's ruling): when nothing anywhere claims the
    // action, the turn must still answer. Only a real player action gets the
    // refusal; an after pass that nothing answers is normal and stays quiet.
    // The whole tail folds away (any_unruled) in a game where every action
    // has a free rule, which every all-standard-verbs game does.
    if any_unruled is 1
        let f = run_free(action)
        if f is 0
            if action < after_floor
                // A refusal like any other: no after pass follows "You
                // can't do that." (found with the as-player matrix,
                // 2026-10-24), and a chained line stops here.
                change refused to 1
                msg_cant_do
        return
    run_free(action)

// The after phase (docs/01 chapter 13 step 6) lives at dispatch's call sites
// in the loop, not in a helper block, so that games without a single
// `on after` fold it to NOTHING (a wrapper block would cost its call layer
// even unused; the doctrine is pay-for-use). The loop runs, after a
// dispatch that nothing refused, the same chain again under the action's
// synthetic after number: dispatch itself is re-entered with it, the after
// number passes the meta compare (afters sort below the metas), and react
// routines answer it only with their `on after` handlers. Grain quips are
// flavor, not world actions, so a grain turn takes no after pass.
