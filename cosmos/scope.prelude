// Scope and light (docs/01 chapter 7), written in Arcturus. Scope is the
// set of objects the parser considers and an action may touch; light decides
// whether the location is lit, which collapses scope to what the player carries
// when dark. Closed/transparent container nuances and held-container recursion
// are refined later; this covers the room, its contents, carried items, and the
// contents of in-scope supporters and open containers.

// Is the location lit? The room's own lit, or an in-scope object glowing.
block is_lit()
    if here is lit
        return 1
    for each held in player
        if held is lit
            return 1
    for each near in here
        if near is lit
            return 1
    return 0

// Does this object span the current room? A fixed object declared to span
// several rooms (docs/01 chapter 3) lives in one room in the object tree but is
// in scope in each room it spans, so a door reaches both sides and a piece of
// scenery is referable from every room that can see it.
block spans_here(obj)
    let addr = spans_addr(obj)
    if addr is nothing
        return 0
    let count = spans_count(obj)
    let i = 0
    while i < count
        if peek_word(addr, i) is here
            return 1
        change i to i + 1
    return 0

// A noun match among the objects that span the current room. They are in scope
// here (spans_here) but do not live in this room's tree, so the room-and-carry
// walk the matcher does first cannot reach them; this scan fills that gap. It
// runs only when the ordinary match has already failed.
block spans_match(target)
    let i = 1
    while i <= object_count
        if spans_here(i)
            if i is not hidden
                if has_word(i, target)
                    return i
        change i to i + 1
    return nothing

// The room across a door from where the player stands. A door joins two
// rooms: it lives in one (its tree parent) and spans the other, so the far
// side is the one that is not `here`. Returns nothing for a door with no
// second room. door_far_side below is the from-anywhere twin for the way
// family; the two stay separate so a doors game that never pathfinds keeps
// its exact bytes (DCE drops the twin unused).
block door_other_side(door)
    let home = parent_of(door)
    if here is home
        let addr = spans_addr(door)
        if addr is nothing
            return nothing
        return peek_word(addr, 0)
    return home

// The room across a door from a given room (the path engine's form).
block door_far_side(d, origin)
    let home = parent_of(d)
    if origin is home
        let addr = spans_addr(d)
        if addr is nothing
            return nothing
        return peek_word(addr, 0)
    return home

// ==========================================================================
// THE WAY FAMILY (docs/01 chapter 8): the room graph, queryable from author
// code. A direction is named by its INDEX (the exit_prop world), and absence
// is always the constant no_way (-1), never 0, which stays honest north.
// Every block here folds away unless called; way_toward alone brings the
// path scratch (crumbs and fringe) into the build.
// ==========================================================================

// Does this door bar travel? The path engine's per-door seam: by default a
// door that is not open bars the way. Override it and a bead curtain never
// bars, or a haunted arch bars even when open.
block door_bars(d)
    if d is open
        return 0
    return 1

// May a path pass through this room? The engine's per-room seam: everything
// by default. The pathfinding granule narrows it to the player's knowledge
// (visited rooms) while a GO TO or FIND is resolving; an NPC walking the
// same graph is not bound by what the player has seen.
block path_admits(r)
    return 1

// The direction index leading from room a straight to room b, or no_way when
// they are not adjacent. This is the MAP: doors are read through to their far
// side whatever their state, because adjacency is topology, not passability
// (way_toward is the walk, and it respects door_bars).
block way_between(a, b)
    let n = exits_count
    let i = 0
    while i < n
        let d = exit_dest(a, exit_prop(i))
        if d is not nothing
            if any_doors is 1
                if d is door
                    change d to door_far_side(d, a)
            if d is b
                return i
        change i to i + 1
    return no_way

// The first step of a shortest path from room a to room b: a direction index,
// or no_way when no path exists (or a is already b; the caller owns that
// case). The WALK: a breadth-first search over the room graph, doors passing
// only where door_bars says so, rooms admitted only where path_admits says
// so. Computed exits are read exactly as the go handler and verbose_exits
// read them; the handbook already requires them to be side-effect-free.
// The scratch lives in __pathbuf__: one crumb byte per object (the first-step
// direction that discovered the room, +1; 0 unseen; 255 the origin), then
// the fringe, one word per object, the frontier queue.
block way_toward(a, b)
    if a is b
        return no_way
    if path_admits(b) is 0
        return no_way
    let crumbs = path_buf
    let fringe = crumbs + object_count + 1
    let i = 0
    while i <= object_count
        poke_byte(crumbs + i, 0)
        change i to i + 1
    poke_byte(crumbs + a, 255)
    poke_word(fringe, 0, a)
    let head = 0
    let tail = 1
    while head < tail
        let r = peek_word(fringe, head)
        change head to head + 1
        change i to 0
        while i < exits_count
            let d = exit_dest(r, exit_prop(i))
            if d is not nothing
                if any_doors is 1
                    if d is door
                        if door_bars(d) is 1
                            change d to nothing
                        else
                            change d to door_far_side(d, r)
                if d is not nothing
                    if peek_byte(crumbs + d) is 0
                        if path_admits(d) is 1
                            let c = peek_byte(crumbs + r)
                            if c is 255
                                change c to i + 1
                            poke_byte(crumbs + d, c)
                            if d is b
                                return c - 1
                            poke_word(fringe, tail, d)
                            change tail to tail + 1
            change i to i + 1
    return no_way

// Is obj in scope right now?
block in_scope(obj)
    if obj is player
        return 1
    // Backstage (docs/01 chapter 3): an object placed `in scope` lives in an
    // invisible room whose contents are in scope EVERYWHERE, light or dark:
    // the home of a companion who follows, of parts of them, of anything the
    // parser should always answer for. It is never listed (its room is never
    // entered), so a backstage object defends itself in its own handlers.
    // The check folds away in a game that places nothing there.
    if any_scoperoom is 1
        if obj is in scope_room
            return 1
    if is_lit is 0
        // Dark: only what the player carries is in scope.
        if obj in player
            return 1
        return 0
    if obj is here
        return 1
    // Spanning objects are checked only in a game that has any; the guard folds
    // away and the spans blocks drop out otherwise (docs/01 chapter 3).
    if any_spans is 1
        if spans_here(obj)
            return 1
    let p = parent_of(obj)
    if p is here
        return 1
    if p is player
        return 1
    if p is not nothing
        // A component (a lever in a machine, docs/01) is in scope wherever
        // the thing it is part of is: the tree carries the relation, the
        // attribute grants the visibility a plain thing's insides never get.
        if any_components is 1
            if obj is component
                return in_scope(p)
        // On a supporter, or inside a container the player can see into (open,
        // clear, or lidless), that is itself in scope. see_into is the single
        // rule both this and the noun matcher share.
        if p is supporter
            return in_scope(p)
        if p is container
            if see_into(p)
                return in_scope(p)
    return 0

// Visible needs light (examining); reachable also needs to not be shut away.
block visible(obj)
    if is_lit is 0
        return 0
    return in_scope(obj)

// The shut container standing between the player's hand and the object, or
// nothing when the way is clear. Sight and touch differ exactly here: a
// closed CLEAR jar shows its coin (see_into) and still blocks the hand.
block reach_blocker(obj)
    let p = parent_of(obj)
    while p is not nothing
        if p is here
            return nothing
        if p is player
            return nothing
        if p is container
            if p is openable
                if p is not open
                    return p
        change p to parent_of(p)
    return nothing

// Visible AND touchable: the documented contract (docs/01 chapter 7), which
// taking and most physical actions want. `<obj> is reachable` reads it as a
// predicate.
block reachable(obj)
    if visible(obj) is 0
        return 0
    if reach_blocker(obj) is nothing
        return 1
    return 0
