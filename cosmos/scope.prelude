// Scope and light (docs/01 chapter 7), written in Arcturus. Scope is the
// set of objects the parser considers and an action may touch; light decides
// whether the location is lit, which collapses scope to what the player carries
// when dark. Closed/transparent container nuances and held-container recursion
// are refined later; this covers the room, its contents, carried items, and the
// contents of in-scope supporters and open containers.

// Is the location lit? The room's own lit, or an in-scope object glowing.
block is_lit()
    if here is lit
        return 1
    for each held in player
        if held is lit
            return 1
    for each near in here
        if near is lit
            return 1
    return 0

// Does this object span the current room? A fixed object declared to span
// several rooms (docs/01 chapter 3) lives in one room in the object tree but is
// in scope in each room it spans, so a door reaches both sides and a piece of
// scenery is referable from every room that can see it.
block spans_here(obj)
    let addr = spans_addr(obj)
    if addr is nothing
        return 0
    let count = spans_count(obj)
    let i = 0
    while i < count
        if peek_word(addr, i) is here
            return 1
        change i to i + 1
    return 0

// A noun match among the objects that span the current room. They are in scope
// here (spans_here) but do not live in this room's tree, so the room-and-carry
// walk the matcher does first cannot reach them; this scan fills that gap. It
// runs only when the ordinary match has already failed.
block spans_match(target)
    let i = 1
    while i <= object_count
        if spans_here(i)
            if i is not hidden
                if any_lighttopology is 1
                    if light_dims(i) is 1
                        change i to i + 1
                if has_word(i, target)
                    return i
        change i to i + 1
    return nothing

// The room across a door from where the player stands. A door joins two
// rooms: it lives in one (its tree parent) and spans the other, so the far
// side is the one that is not `here`. Returns nothing for a door with no
// second room. door_far_side below is the from-anywhere twin for the way
// family; the two stay separate so a doors game that never pathfinds keeps
// its exact bytes (DCE drops the twin unused).
block door_other_side(door)
    let home = parent_of(door)
    if here is home
        let addr = spans_addr(door)
        if addr is nothing
            return nothing
        return peek_word(addr, 0)
    return home

// The room across a door from a given room (the path engine's form).
block door_far_side(d, origin)
    let home = parent_of(d)
    if origin is home
        let addr = spans_addr(d)
        if addr is nothing
            return nothing
        return peek_word(addr, 0)
    return home

// ==========================================================================
// THE WAY FAMILY (docs/01 chapter 8): the room graph, queryable from author
// code. A direction is named by its INDEX (the exit_prop world), and absence
// is always the constant no_way (-1), never 0, which stays honest north.
// Every block here folds away unless called; way_toward alone brings the
// path scratch (crumbs and fringe) into the build.
// ==========================================================================

// Does this door bar travel? The path engine's per-door seam: by default a
// door that is not open bars the way. Override it and a bead curtain never
// bars, or a haunted arch bars even when open.
block door_bars(d)
    if d is open
        return 0
    return 1

// May a path pass through this room? The engine's per-room seam: everything
// by default. The pathfinding granule narrows it to the player's knowledge
// (visited rooms) while a GO TO or FIND is resolving; an NPC walking the
// same graph is not bound by what the player has seen.
block path_admits(r)
    return 1

// The direction index leading from room a straight to room b, or no_way when
// they are not adjacent. This is the MAP: doors are read through to their far
// side whatever their state, because adjacency is topology, not passability
// (way_toward is the walk, and it respects door_bars).
block way_between(a, b)
    let n = exits_count
    let i = 0
    while i < n
        let d = exit_dest(a, exit_prop(i))
        if d is not nothing
            if any_doors is 1
                if d is door
                    change d to door_far_side(d, a)
            if d is b
                return i
        change i to i + 1
    return no_way

// The first step of a shortest path from room a to room b: a direction index,
// or no_way when no path exists (or a is already b; the caller owns that
// case). The WALK: a breadth-first search over the room graph, doors passing
// only where door_bars says so, rooms admitted only where path_admits says
// so. Computed exits are read exactly as the go handler and verbose_exits
// read them; the handbook already requires them to be side-effect-free.
// The scratch lives in __pathbuf__: one crumb byte per object (the first-step
// direction that discovered the room, +1; 0 unseen; 255 the origin), then
// the fringe, one word per object, the frontier queue.
block way_toward(a, b)
    if a is b
        return no_way
    if path_admits(b) is 0
        return no_way
    let crumbs = path_buf
    let fringe = crumbs + object_count + 1
    let i = 0
    while i <= object_count
        poke_byte(crumbs + i, 0)
        change i to i + 1
    poke_byte(crumbs + a, 255)
    poke_word(fringe, 0, a)
    let head = 0
    let tail = 1
    while head < tail
        let r = peek_word(fringe, head)
        change head to head + 1
        change i to 0
        while i < exits_count
            let d = exit_dest(r, exit_prop(i))
            if d is not nothing
                if any_doors is 1
                    if d is door
                        if door_bars(d) is 1
                            change d to nothing
                        else
                            change d to door_far_side(d, r)
                if d is not nothing
                    if peek_byte(crumbs + d) is 0
                        if path_admits(d) is 1
                            let c = peek_byte(crumbs + r)
                            if c is 255
                                change c to i + 1
                            poke_byte(crumbs + d, c)
                            if d is b
                                return c - 1
                            poke_word(fringe, tail, d)
                            change tail to tail + 1
            change i to i + 1
    return no_way

// The light-level seam (docs/01 chapter 22, lighttopology): does the
// level of light where the player stands hide this thing? Never, by
// default; the granule overrides it with the needs_light test. The stub
// exists so the folded calls above resolve; unsummoned, nothing calls it.
block light_dims(obj)
    return 0

// Is this belonging on show (docs/01 chapter 3)? Either the thing itself
// is `exposed`, or the character holding it is: an exposed character
// shows everything it carries and wears, and the player never counts
// (their belongings are the inventory). Reached only behind any_exposed.
block exposed_now(obj)
    let p = parent_of(obj)
    if p is player
        return 0
    if obj is exposed
        return 1
    if p is nothing
        return 0
    if p is animate
        if p is exposed
            return 1
    return 0

// Is obj in scope right now?
block in_scope(obj)
    if obj is player
        return 1
    // Backstage (docs/01 chapter 3): an object placed `in scope` lives in an
    // invisible room whose contents are in scope EVERYWHERE, light or dark:
    // the home of a companion who follows, of parts of them, of anything the
    // parser should always answer for. It is never listed (its room is never
    // entered), so a backstage object defends itself in its own handlers.
    // The check folds away in a game that places nothing there.
    if any_scoperoom is 1
        if obj is in scope_room
            return 1
    if is_lit is 0
        // Dark: only what the player carries is in scope.
        if obj in player
            return 1
        return 0
    // Too dim to see (summon.lighttopology, a thing's needs_light above
    // the room's level): out of scope like a hidden thing. Folds away
    // unsummoned; the stub below is then dead and DCE reclaims it.
    if any_lighttopology is 1
        if light_dims(obj) is 1
            return 0
    if obj is here
        return 1
    // Spanning objects are checked only in a game that has any; the guard folds
    // away and the spans blocks drop out otherwise (docs/01 chapter 3).
    if any_spans is 1
        if spans_here(obj)
            return 1
    let p = parent_of(obj)
    if p is here
        return 1
    if p is player
        return 1
    // Place-by-place scope (docs/01 chapter 7): `untouchable from balcony`
    // and `adjacent to hatch` bring a thing, or a whole holder's contents,
    // into scope at places it does not sit in. Asked before the holder
    // rules below, which return early. Folds away in a game that declares
    // neither (any_views).
    if any_views is 1
        if view_busy is 0
            if view_scope(obj) is not 0
                return 1
    if p is not nothing
        // A component (a lever in a machine, docs/01) is in scope wherever
        // the thing it is part of is: the tree carries the relation, the
        // attribute grants the visibility a plain thing's insides never get.
        if any_components is 1
            if obj is component
                return in_scope(p)
        // A character's exposed belonging (docs/01 chapter 3): the hat
        // someone wears, the passport they wave. In scope while its holder
        // is; the take probe keeps it in the holder's hands. A character's
        // other belongings stay private, the house rule.
        if any_exposed is 1
            if p is animate
                if exposed_now(obj) is 1
                    return in_scope(p)
        // On a supporter, or inside a container the player can see into (open,
        // clear, or lidless), that is itself in scope. see_into is the single
        // rule both this and the noun matcher share.
        if p is supporter
            return in_scope(p)
        if p is container
            if see_into(p)
                return in_scope(p)
    return 0

// PLACE-BY-PLACE SCOPE (docs/01 chapter 7). A thing or a holder declares
// the places it is seen from (`untouchable from balcony, tower_window`) or
// reached from (`adjacent to serving_hatch`); a place is a room, or an
// object, meaning wherever that object is in scope. Two answers: 1 seen
// only (the reach gate refuses touch with the beyond wording), 2 seen and
// reachable. The walk climbs from the thing through what it sits on or in,
// as far as the player could see in (an open or clear container, a
// supporter, a component's whole, a character's exposed belonging), so a
// coin in the courtyard's shut box stays out of view from the balcony.
// Unreferenced, and so dropped, in a game that declares neither.

// Set while a nested scope question runs (an object place asking whether
// IT is in scope): the nested ask is the ordinary one, so two views that
// name each other can never recurse.
global view_busy = 0

block view_scope(obj)
    let a = obj
    while a is not nothing
        let r = view_here(a)
        if r is not 0
            return r
        let p = parent_of(a)
        if p is nothing
            return 0
        if p is container
            if see_into(p) is 0
                return 0
        else
            if p is not supporter
                if p is not room
                    let shown = 0
                    if any_components is 1
                        if a is component
                            change shown to 1
                    if any_exposed is 1
                        if p is animate
                            if exposed_now(a) is 1
                                change shown to 1
                    if shown is 0
                        return 0
        change a to p
    return 0

// Does this one object name the player's place? adjacent first, so a
// thing both seen from one place and reached from another reaches where
// it is reached.
block view_here(a)
    if view_list(adjacent_addr(a), adjacent_count(a)) is 1
        return 2
    if view_list(untouchable_addr(a), untouchable_count(a)) is 1
        return 1
    return 0

block view_list(addr, n)
    if addr is 0
        return 0
    let i = 0
    while i < n
        let place = peek_word(addr, i)
        if place is not nothing
            if place is here
                return 1
            if place is not room
                change view_busy to 1
                let seen = in_scope(place)
                change view_busy to 0
                if seen is 1
                    return 1
        change i to i + 1
    return 0

// Is obj in scope ONLY through an `untouchable from` place? Then the reach
// gate refuses touch (beyond_blocked): seen from the balcony, the fountain
// stays a plain touchable thing in its own courtyard.
block view_untouchable(obj)
    if view_busy is 1
        return 0
    change view_busy to 1
    let plain = in_scope(obj)
    change view_busy to 0
    if plain is 1
        return 0
    if view_scope(obj) is 1
        return 1
    return 0

// make_untouchable(chip, droid), make_adjacent(lever, cab): the run-time
// form, and what `change x.untouchable to place` lowers to. One place
// replaces the declared list; nothing clears it. The compiler gives every
// object these name a slot.
block make_untouchable(obj, place)
    view_put(untouchable_addr(obj), untouchable_count(obj), place)
    return 0

block make_adjacent(obj, place)
    view_put(adjacent_addr(obj), adjacent_count(obj), place)
    return 0

// x.untouchable and x.adjacent read the first declared place, or nothing.
block untouchable_first(obj)
    let a = untouchable_addr(obj)
    if a is 0
        return nothing
    return peek_word(a, 0)

block adjacent_first(obj)
    let a = adjacent_addr(obj)
    if a is 0
        return nothing
    return peek_word(a, 0)

block view_put(addr, n, place)
    if addr is 0
        return 0
    poke_word(addr, 0, place)
    let i = 1
    while i < n
        poke_word(addr, i, nothing)
        change i to i + 1
    return 0

// Visible needs light (examining); reachable also needs to not be shut away.
block visible(obj)
    if is_lit is 0
        return 0
    return in_scope(obj)

// The shut container standing between the player's hand and the object, or
// nothing when the way is clear. Sight and touch differ exactly here: a
// closed CLEAR jar shows its coin (see_into) and still blocks the hand.
block reach_blocker(obj)
    let p = parent_of(obj)
    while p is not nothing
        if p is here
            return nothing
        if p is player
            return nothing
        if p is container
            if p is openable
                if p is not open
                    return p
        change p to parent_of(p)
    return nothing

// Visible AND touchable: the documented contract (docs/01 chapter 7), which
// taking and most physical actions want. `<obj> is reachable` reads it as a
// predicate.
block reachable(obj)
    if visible(obj) is 0
        return 0
    if reach_blocker(obj) is nothing
        return 1
    return 0
