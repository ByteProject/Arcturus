// pathfinding_spanish.granule
// part of Arcturus, a programming language and compiler for the Infocom Z-machine.
// Copyright (c) 2026, Stefan Vogt.
// https://github.com/ByteProject/Arcturus
//
// The pathfinding granule's SPANISH wording and grammar: the loader adds
// this companion automatically when summon.pathfinding meets a Spanish
// game (docs/01 chapter 22, language companions). The logic stays in
// pathfinding.granule. Wording written natively, never calqued; the
// door frame sidesteps gender agreement by letting the door do the
// blocking ("cierra el paso") instead of being described.

// VE A <lugar>; BUSCA and ENCUENTRA walk to what you know; MIRA
// <dirección> asks what lies that way, bare or with "hacia" or "al".

enhance verb "ir"
    goto_room a text
    goto_room al text
    goto_room hacia text

verb "busca", "buscar", "encuentra", "encontrar"
    find_where text

enhance verb "mirar"
    look_way direction
    look_way hacia direction
    look_way hacia el direction
    look_way al direction

block line_stride()
    say "(pasas por ${the here})"

block line_seek_notice(r)
    say "(te encaminas hacia ${the r})"

block msg_already_there()
    say "Ya estás ahí."

block msg_no_way_known()
    say "No conoces el camino hasta allí."

block msg_unknown_place()
    say "No conoces ese lugar."

block msg_seek_unknown()
    say "No sabes de nada parecido."

block msg_find_here(o)
    say "${The o} está aquí mismo."

block msg_seek_near(o)
    say "${The o} debería andar por aquí."

block msg_nothing_that_way()
    say "Por ahí no hay nada."

block msg_door_shut_way(d)
    let at = dir_word_at
    if at is 0
        say "${The d} cierra el paso por ahí."
        return 0
    show("${The d} cierra el paso hacia el ")
    show_dir_word(at, 0)
    say "."

block msg_way_lies(d)
    let at = dir_word_at
    if at is 0
        say "Por ahí queda ${the d}."
        return 0
    show("Hacia el ")
    show_dir_word(at, 0)
    say " queda ${the d}."

block msg_way_unknown()
    let at = dir_word_at
    if at is 0
        say "El camino está abierto, pero nunca has estado allí."
        return 0
    show("El camino hacia el ")
    show_dir_word(at, 0)
    say " está abierto, pero nunca has estado allí."
